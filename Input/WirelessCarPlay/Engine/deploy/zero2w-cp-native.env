# Zero2W real-CarPlay sidecar configuration.
#
# Loaded by zero2w-cp-native.service through EnvironmentFile= and directly by
#   cp-native --env-file /etc/zero2w/cp-native.env <command>
# An empty value falls back to the built-in default named in the comment.
# `cp-native config --env-file <this file>` prints what will actually be used.

# --- regulatory domain: REQUIRED, deliberately has no default --------------
# ISO 3166-1 alpha-2 for the country the vehicle is used in. The board reports
# `country 00` today, and hostapd will not open a 5 GHz channel in that domain.
# Setting a domain you are not entitled to use is illegal: set the real one.
CP_COUNTRY=

# --- CarPlay access point: the Wi-Fi radio only ---------------------------
# Never point CP_AP_IFACE at usb0; the binary refuses that combination.
CP_AP_IFACE=wlan0
CP_AP_SSID=ZERO2W-CarPlay
# Empty falls back to the built-in default "zero2w-carplay". Set a unique
# 8..63 byte passphrase before using the AP anywhere public.
CP_AP_PASSPHRASE=
# Non-DFS channels only: 1..=13, or 36/40/44/48/149/153/157/161.
CP_AP_CHANNEL=36
CP_AP_WIDTH=40
CP_AP_IP=10.10.0.1
CP_AP_MAX_STA=4

# --- AirPlay receiver identity --------------------------------------------
CP_DEVICE_NAME=ZERO2W
# 7000 matches the LIVI reference receiver; 8080 (the C++ core web UI) is refused.
CP_AIRPLAY_PORT=7000
CP_SOURCE_VERSION=950.7.1
# Pairing key / identifier TXT records. Empty until a protocol engine exists;
# the publisher then omits pk/pi exactly like the reference receiver does.
CP_AIRPLAY_PK=
CP_AIRPLAY_PI=

# --- MFi coprocessor: locked to the external adapter ----------------------
# /dev/i2c-1 @ 0x10 is the external PI7/PI8 controller (i2c@5002400), verified
# with Input/WirelessCarPlay/MFI/auth3-native. /dev/i2c-2 is the on-board AC200 (i2c@5002c00) and is
# refused by the binary whatever is written here.
CP_MFI_BUS=1
CP_MFI_ADDR=0x10
CP_MFI_TOOL=/root/MFIAuth/auth3-native
# -1 keeps the chip on its external supply; a GPIO line number power-cycles it.
CP_MFI_POWER_GPIO=-1

# --- USB RNDIS debug link: must survive every AP operation ----------------
CP_RNDIS_IFACE=usb0
CP_RNDIS_IP=192.168.77.2
CP_RNDIS_UNITS=zero2w-usb-rndis.service,zero2w-usb-dhcp.service
# 1 = refuse to touch the radio unless the debug link is up.
CP_REQUIRE_RNDIS=1

# --- control socket, runtime directory, engine ----------------------------
CP_RUNTIME_DIR=/run/zero2w
CP_CORE_SOCKET=/run/zero2w/cp-native.sock
# "selftest" never advertises AirPlay. "catplay" requires an independently
# built external engine to pass --cp-capabilities-json, including explicit
# input_only support.
CP_ENGINE=selftest
CP_CATPLAY_ENGINE_PATH=/root/zero2w/bin/cp-catplay-bridge

# Development preserves USB RNDIS and starts CatPlay with --cp-input-only.
# Use `cp-native run --no-ap` for an engine-only development session: it leaves
# USB/UDC/configfs, the Wi-Fi radio, and the mDNS publisher untouched while the
# engine telemetry socket remains supervised. Vehicle starts --cp-bridge,
# assigns the only UDC to wired CarPlay, and is rejected unless one explicit
# management/offline acknowledgement is set and CP_REQUIRE_RNDIS=0.
CP_USB_PROFILE=development
CP_ALT_MANAGEMENT_CONFIRMED=0
CP_OFFLINE_DEPLOYMENT_CONFIRMED=0

# --- bounds (caps are compiled in, these only lower them) -----------------
CP_EVENT_RING=128
CP_FRAME_CACHE=4
CP_IPC_LINE_BYTES=1024
CP_IPC_CLIENTS=2
