+        assert_eq!(actions(0x8013, [0; 4], b"back", 1, 1).unwrap(), vec![Action::Hid { kind: 2, bytes: vec![4, 0, 0, 0], release: true }]);
+        assert_eq!(actions(0x8013, [0; 4], b"select_up", 1, 1).unwrap(), vec![Action::Hid { kind: 2, bytes: vec![0; 4], release: false }]);
+        assert!(actions(0x8013, [0; 4], b"unmapped", 1, 1).is_none());
+        assert_eq!(actions(0x8017, [1, 0, 0, 0], b"night_mode", 1, 1).unwrap(), vec![Action::Night(true)]);
