+//! CPMF controls to actual receiver commands/HID reports. IPC numbers are local;
+//! HID layouts follow catplay_hid and LIVI stack/hid.ts. Unknown operations are
+//! rejected, never acknowledged as executed. No external device side effects here.
+use catplay_carplay::{carplay_rx::AirPlayReceiverHandleRef, msg::{Command, CommandRequestSiri, CommandSetNightMode, CommandSetLimitedUI, HidDevice, SiriAction}};
+use catplay_hid::{KnobReport, MediaButtonsReport, TelephonyButtonsReport, ProximityReport};
+use std::time::Instant;
+
+pub const CONTACTS: usize = 2;
+pub const MAX_PAYLOAD: usize = 192;
+const MAIN: &str = "5E2D6D6C-8E32-4E2A-9A74-000000001080";
+
+pub fn device(kind: u8) -> Option<HidDevice> {
+    let (name, descriptor) = match kind {
+        0 => ("Media", MediaButtonsReport::descriptor().to_vec()),
+        1 => ("Telephone", TelephonyButtonsReport::descriptor().to_vec()),
+        2 => ("Knob", KnobReport::descriptor().to_vec()),
+        3 => ("Proximity", ProximityReport::descriptor().to_vec()),
+        _ => return None,
+    };
+    Some(HidDevice { display_uuid: MAIN.into(), hid_country_code: 0,
+        hid_descriptor: descriptor.into(), hid_product_id: 2 + kind as u16,
+        hid_vendor_id: 2, name: format!("Zero2W {name}"),
+        uuid: format!("5E2D6D6C-8E32-4E2A-9A74-00000000109{kind}") })
+}
+
+pub fn multi_device(single: &HidDevice) -> HidDevice {
+    let mut multi = single.clone();
+    let single_bytes = single.hid_descriptor.as_ref();
+    let mut descriptor = single_bytes[..6].to_vec();
+    for _ in 0..CONTACTS {
+        descriptor.extend_from_slice(&[0x05, 0x0d]);
+        descriptor.extend_from_slice(&single_bytes[6..single_bytes.len() - 1]);
+    }
+    descriptor.push(0xc0);
+    multi.hid_descriptor = descriptor.into();
+    multi.uuid = "5E2D6D6C-8E32-4E2A-9A74-000000001083".into();
+    multi.name = "Zero2W Multitouch".into();
+    multi
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum Action {
+    Hid { kind: u8, bytes: Vec<u8>, release: bool },
+    Siri(u32),
+    Touch(Vec<u8>),
+    Night(bool),
+    LimitedUi(bool),
+}
+
+fn knob_key(code: u32) -> Option<Vec<u8>> {
+    if !(1..=9).contains(&code) { return None; }
+    Some(KnobReport::new(code == 1, code == 2, code == 3,
+        if code == 4 { -1 } else if code == 5 { 1 } else { 0 },
+        if code == 6 { -1 } else if code == 7 { 1 } else { 0 },
+        if code == 8 { -1 } else if code == 9 { 1 } else { 0 }).to_bytes().to_vec())
+}
+
+fn text(payload: &[u8]) -> Option<&str> {
+    let payload = payload.strip_suffix(&[0]).unwrap_or(payload);
+    if payload.contains(&0) { return None; }
+    std::str::from_utf8(payload).ok()
+}
+
+/// Return a fully validated bounded batch before sending anything to the phone.
+pub fn actions(kind: u16, p: [u32; 4], payload: &[u8], width: u32, height: u32) -> Option<Vec<Action>> {
+    if payload.len() > MAX_PAYLOAD { return None; }
+    let mut out = Vec::new();
+    match kind {
+        0x8010 if p[1] <= 1 && p[2..] == [0, 0] => {
+            let category = p[0] >> 16;
+            let code = p[0] & 0xffff;
+            text(payload)?;
+            if (category == 0 && code <= 6) || (category == 1 && code <= 17) {
+                out.push(Action::Hid { kind: category as u8, bytes: vec![if p[1] == 1 { 0 } else { code as u8 }], release: p[1] == 0 });
+            } else if category == 2 {
+                let mut bytes = knob_key(code)?;
+                if p[1] == 1 { bytes.fill(0); }
+                out.push(Action::Hid { kind: 2, bytes, release: p[1] == 0 });
+            } else { return None; }
+        }
+        0x8011 if (1..=CONTACTS as u32).contains(&p[0]) && p[1..] == [0, 0, 0] && payload.len() == p[0] as usize * 8 => {
+            let mut report = vec![0; CONTACTS * 6];
+            let mut seen = [false; CONTACTS];
+            for i in 0..CONTACTS { report[i * 6] = i as u8; }
+            for point in payload.chunks_exact(8) {
+                let x = u16::from_be_bytes([point[0], point[1]]);
+                let y = u16::from_be_bytes([point[2], point[3]]);
+                let id = point[4] as usize;
+                if id >= CONTACTS || seen[id] || point[5] > 2 || point[6..] != [0, 0] || x as u32 >= width || y as u32 >= height { return None; }
+                seen[id] = true;
+                let off = id * 6;
+                report[off + 1] = u8::from(point[5] != 0);
+                report[off + 2..off + 4].copy_from_slice(&x.to_le_bytes());
+                report[off + 4..off + 6].copy_from_slice(&y.to_le_bytes());
+            }
+            out.push(Action::Touch(report));
+        }
+        0x8012 if p[0] <= 4 && p[2..] == [0, 0] && payload.is_empty() => {
+            let n = (p[1] as i32).checked_abs()?;
+            if n > 127 { return None; }
+            let (x, y) = match p[0] { 0 => (-n as i8, 0), 1 => (n as i8, 0), 2 => (0, -n as i8), 3 => (0, n as i8), _ => (0, 0) };
+            out.push(Action::Hid { kind: 2, bytes: KnobReport::new(p[0] == 4, false, false, x, y, 0).to_bytes().to_vec(), release: true });
+        }
+        0x8013 if p == [0; 4] => {
+            let name = text(payload)?;
+            let code = match name { "select" | "select_down" | "select_up" => 1,
+                "home" => 2, "back" => 3, "left" => 4, "right" => 5,
+                "up" => 6, "down" => 7, "wheel_left" => 8, "wheel_right" => 9,
+                _ => return None };
+            let mut bytes = knob_key(code)?;
+            if name == "select_up" { bytes.fill(0); }
+            out.push(Action::Hid { kind: 2, bytes, release: name != "select_down" && name != "select_up" });
+        }
+        0x8014 if p[0] <= 1 && p[1..] == [0, 0, 0] && payload.is_empty() => {
+            out.push(Action::Hid { kind: 3, bytes: vec![p[0] as u8], release: false });
+        }
+        0x8015 if p[0] <= 2 && p[1..] == [0, 0, 0] && payload.is_empty() => { out.push(Action::Siri(p[0])); }
+        0x8016 if p[1..] == [0, 0, 0] => {
+            let digits = text(payload)?;
+            let mut keys = Vec::new();
+            match p[0] {
+                0 if digits.is_empty() => keys.push(1),
+                1 if digits.is_empty() => keys.push(3),
+                4 if digits.is_empty() => keys.push(4),
+                2 | 3 if !digits.is_empty() && digits.len() <= 15 => {
+                    for c in digits.bytes() { keys.push(match c { b'0'..=b'9' => c - b'0' + 5, b'*' => 15, b'#' => 16, _ => return None }); }
+                    if p[0] == 2 { keys.push(1); }
+                }
+                _ => return None,
+            }
+            for key in keys { out.push(Action::Hid { kind: 1, bytes: vec![key], release: true }); }
+        }
+        0x8017 if p[0] <= 1 && p[1..] == [0, 0, 0] => {
+            out.push(match text(payload)? {
+                "night_mode" => Action::Night(p[0] != 0),
+                "limited_ui" => Action::LimitedUi(p[0] != 0),
+                _ => return None,
+            });
+        }
+        _ => return None,
+    }
+    Some(out)
+}
+
+pub fn dispatch(handle: &AirPlayReceiverHandleRef, touch: Option<&HidDevice>, actions: Vec<Action>) {
+    for action in actions {
+        match action {
+            Action::Hid { kind, bytes, release } => if let Some(device) = device(kind) {
+                handle.send_hid_report(Instant::now(), &device, &bytes);
+                if release { handle.send_hid_report(Instant::now(), &device, &vec![0; bytes.len()]); }
+            },
+            Action::Touch(bytes) => if let Some(device) = touch { handle.send_hid_report(Instant::now(), &multi_device(device), &bytes); },
+            Action::Night(night_mode) => handle.send_command_and_forget(Command::SetNightMode(CommandSetNightMode { night_mode })),
+            Action::LimitedUi(limited_ui) => handle.send_command_and_forget(Command::SetLimitedUI(CommandSetLimitedUI { limited_ui })),
+            Action::Siri(value) => {
+                let siri_action = match value { 1 => SiriAction::ButtonUp, 2 => SiriAction::Prewarm, _ => SiriAction::ButtonDown };
+                handle.send_command_and_forget(Command::RequestSiri(CommandRequestSiri { siri_action }));
+            }
+        }
+    }
+}
+
