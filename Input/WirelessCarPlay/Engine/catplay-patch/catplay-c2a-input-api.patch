+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn text_is_bounded_without_splitting_or_injecting_fields() {
+        assert_eq!(bounded("abc你好", 5), "abc");
+        assert_eq!(bounded("a\0b", 99), "ab");
+        assert_eq!(bounded("", 0), "");
+    }
+    #[test]
+    fn real_subscription_update_produces_bounded_incremental_cpmf_metadata() {
+        let media = MediaTap::test_tap();
+        let epoch = media.test_begin_session();
+        let mut input = InputIap2::new(media.clone(), epoch);
+        input.update_metadata(&NowPlayingUpdate {
+            media_item: Some(MediaItem { title: Some("测试标题".into()), artist: Some("artist".into()), playback_duration_in_ms: Some(42), ..Default::default() }),
+            playback_attributes: Some(PlaybackAttributes { playback_status: Some(PlaybackStatus::Playing), playback_elapsed_time_ms: Some(12), ..Default::default() }),
+        });
+        let (kind, p, bytes) = media.test_pop_extension().unwrap();
+        assert_eq!(kind, 0x30); assert_eq!(p, [3, 42, 12, 0]);
+        assert!(bytes.starts_with("测试标题\0artist\0".as_bytes()));
+        input.update_metadata(&NowPlayingUpdate { media_item: None, playback_attributes: Some(PlaybackAttributes { playback_elapsed_time_ms: Some(20), ..Default::default() }) });
+        let (_, p, next) = media.test_pop_extension().unwrap();
+        assert_eq!(p[2], 20); assert_eq!(next, bytes);
+        media.end_session_for_epoch(epoch, 0);
+        input.update_metadata(&NowPlayingUpdate::default());
+        assert!(media.test_pop_extension().is_none());
+    }
+}
