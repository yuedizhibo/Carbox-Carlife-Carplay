+//! Real wireless iAP2 subscription -> bounded CPMF metadata/telephony/artwork.
+//! No file/OTA/activation success is synthesized by this adapter.
+use async_trait::async_trait;
+use catplay_csm::{decoder::{CsmFlag, CsmPacketBox}, msg::*};
+use catplay_iap2_client::{CsmSession, CsmSessionResult, CsmClientHandleRef, CsmFileTransferEvent};
+use crate::MediaTap;
+
+pub struct InputIap2 {
+    media: MediaTap,
+    epoch: u64,
+    fields: [String; 6],
+    duration: u32,
+    position: u32,
+    track: u32,
+    playing: bool,
+    art_id: Option<u8>,
+    art_revision: u32,
+}
+
+fn bounded(value: &str, limit: usize) -> String {
+    let mut n = value.len().min(limit);
+    while !value.is_char_boundary(n) { n -= 1; }
+    value[..n].replace('\0', "")
+}
+
+impl InputIap2 {
+    pub fn new(media: MediaTap, epoch: u64) -> Self {
+        Self { media, epoch, fields: Default::default(), duration: 0, position: 0, track: 0,
+            playing: false, art_id: None, art_revision: 0 }
+    }
+    fn update_metadata(&mut self, update: &NowPlayingUpdate) {
+        if let Some(item) = update.media_item.as_ref() {
+            let texts = [(0, &item.title), (1, &item.artist), (2, &item.album_title), (3, &item.album_artist), (5, &item.genre)];
+            for (index, value) in texts { if let Some(value) = value { self.fields[index] = bounded(value, 127); } }
+            if let Some(value) = item.playback_duration_in_ms { self.duration = value; }
+            if let Some(value) = item.album_track_number { self.track = (self.track & 0xffff) | (value as u32) << 16; }
+            if let Some(value) = item.album_track_count { self.track = (self.track & 0xffff0000) | value as u32; }
+            if let Some(value) = item.artwork_file_transfer_id { self.art_id = Some(value); }
+        }
+        if let Some(playback) = update.playback_attributes.as_ref() {
+            if let Some(value) = playback.playback_elapsed_time_ms { self.position = value; }
+            if let Some(value) = playback.playback_app_name.as_ref() { self.fields[4] = bounded(value, 127); }
+            if let Some(value) = playback.playback_status.as_ref() { self.playing = matches!(value, PlaybackStatus::Playing); }
+        }
+        let mut bytes = Vec::with_capacity(768);
+        for field in &self.fields { bytes.extend_from_slice(field.as_bytes()); bytes.push(0); }
+        self.media.extension(self.epoch, 0x30, [1 | (u32::from(self.playing) << 1), self.duration, self.position, self.track], bytes);
+    }
+}
+
+#[async_trait]
+impl CsmSession for InputIap2 {
+    async fn start(&mut self, handle: CsmClientHandleRef) -> CsmSessionResult<()> {
+        handle.send(&StartNowPlayingUpdates::all())?;
+        handle.send(&StartCallStateUpdates { remote_id: CsmFlag::Yes, display_name: CsmFlag::Yes,
+            status: CsmFlag::Yes, direction: CsmFlag::Yes, call_uuid: CsmFlag::Yes, ..Default::default() })?;
+        Ok(())
+    }
+    async fn respond(&mut self, packet: CsmPacketBox, _handle: CsmClientHandleRef) -> CsmSessionResult<()> {
+        if let Some(update) = packet.cast::<NowPlayingUpdate>() { self.update_metadata(update); }
+        if let Some(call) = packet.cast::<CallStateUpdate>() {
+            let status = match call.status { CallStateUpdateStatus::Disconnected | CallStateUpdateStatus::Disconnecting => 0,
+                CallStateUpdateStatus::Ringing => 1, CallStateUpdateStatus::Sending | CallStateUpdateStatus::Connecting => 2,
+                CallStateUpdateStatus::Active => 3, CallStateUpdateStatus::Held => 4 };
+            let mut bytes = bounded(call.display_name.as_deref().unwrap_or(""), 127).into_bytes();
+            bytes.push(0);
+            bytes.extend_from_slice(bounded(call.remote_id.as_deref().unwrap_or(""), 95).as_bytes());
+            bytes.push(0);
+            self.media.extension(self.epoch, 0x36, [status, 0, 0, 2], bytes);
+        }
+        Ok(())
+    }
+    async fn on_file_event(&mut self, id: u8, event: CsmFileTransferEvent, _handle: CsmClientHandleRef) -> CsmSessionResult<()> {
+        if self.art_id != Some(id) { return Ok(()); }
+        match event {
+            CsmFileTransferEvent::Completed { data, size, .. } if size == data.len() as u64 && size > 0 && size <= 128 * 1024 => {
+                self.art_revision = self.art_revision.wrapping_add(1).max(1);
+                self.media.extension(self.epoch, 0x31, [0, 1, size as u32, self.art_revision], data);
+                self.art_id = None;
+            }
+            CsmFileTransferEvent::Cancelled => self.art_id = None,
+            _ => {}
+        }
+        Ok(())
+    }
+}
