+        assert!(actions(0x8012, [0, i32::MIN as u32, 0, 0], &[], 1, 1).is_none());
+        assert_eq!(actions(0x8016, [3, 0, 0, 0], b"12*#", 1, 1).unwrap().len(), 4);
+        assert!(actions(0x8016, [3, 0, 0, 0], b"12z", 1, 1).is_none());
+        assert_eq!(actions(0x8015, [1, 0, 0, 0], &[], 1, 1).unwrap(), vec![Action::Siri(1)]);
