diff --git a/c2a/catplay_c2a/src/telemetry.rs b/c2a/catplay_c2a/src/telemetry.rs
new file mode 100644
index 0000000..ec9d927
--- /dev/null
+++ b/c2a/catplay_c2a/src/telemetry.rs
@@ -0,0 +1,492 @@
+use std::{
+    fs,
+    io::{self, ErrorKind},
+    os::unix::{
+        fs::{FileTypeExt, MetadataExt, PermissionsExt},
+        net::UnixListener as StdUnixListener,
+    },
+    path::{Path, PathBuf},
+    time::{Duration, Instant},
+};
+
+use catplay_carplay_rx_gadget::CarPlayWirelessGadgetState;
+use catplay_carplay_tx_gadget::client::CarPlayUsbClientGadgetStatus;
+use serde::Serialize;
+use tokio::net::UnixStream;
+
+use crate::ProdGadgetState;
+
+const DEFAULT_SOCKET: &str = "/run/zero2w/catplay.sock";
+const MAX_CLIENTS: usize = 4;
+const MAX_ACCEPT_ATTEMPTS_PER_SERVICE: usize = 8;
+const MAX_LINE: usize = 4096;
+const HEARTBEAT: Duration = Duration::from_secs(1);
+const MAX_WOULD_BLOCK_RETRIES: u8 = 2;
+const SLOW_CLIENT_DEADLINE: Duration = Duration::from_secs(2);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum TelemetryLifecycle { State(ProdGadgetState), Error }
+impl From<&ProdGadgetState> for TelemetryLifecycle { fn from(value: &ProdGadgetState) -> Self { Self::State(value.clone()) } }
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct TelemetrySnapshot {
+    pub schema_version: u8,
+    pub engine: &'static str,
+    pub lifecycle: &'static str,
+    pub wireless_listener_ready: bool,
+    pub wired_endpoint_ready: bool,
+    pub iphone_connected: bool,
+    pub vehicle_connected: bool,
+    pub bridge_active: bool,
+}
+
+impl TelemetrySnapshot {
+    pub fn initial() -> Self {
+        Self {
+            schema_version: 1,
+            engine: "catplay",
+            lifecycle: "initial",
+            wireless_listener_ready: false,
+            wired_endpoint_ready: false,
+            iphone_connected: false,
+            vehicle_connected: false,
+            bridge_active: false,
+        }
+    }
+
+    pub fn from_gadget_states(
+        lifecycle: TelemetryLifecycle,
+        tx: Option<&CarPlayUsbClientGadgetStatus>,
+        rx: Option<&CarPlayWirelessGadgetState>,
+    ) -> Self {
+        if matches!(&lifecycle, TelemetryLifecycle::Error) { return Self { schema_version: 1, engine: "catplay", lifecycle: lifecycle_name(lifecycle), wireless_listener_ready: false, wired_endpoint_ready: false, iphone_connected: false, vehicle_connected: false, bridge_active: false }; }
+
+        let wireless_listener_ready = matches!(
+            rx,
+            Some(CarPlayWirelessGadgetState::Inviting | CarPlayWirelessGadgetState::Receiving | CarPlayWirelessGadgetState::Passive)
+        );
+        let wired_endpoint_ready = matches!(
+            tx,
+            Some(
+                CarPlayUsbClientGadgetStatus::WaitingForUsbAccessory
+                    | CarPlayUsbClientGadgetStatus::WaitingForInvite
+                    | CarPlayUsbClientGadgetStatus::Invited { .. }
+                    | CarPlayUsbClientGadgetStatus::Connecting
+                    | CarPlayUsbClientGadgetStatus::TransmitterReadyForPickup
+                    | CarPlayUsbClientGadgetStatus::Transmitting
+            )
+        );
+        let iphone_connected = matches!(rx, Some(CarPlayWirelessGadgetState::Receiving));
+        let vehicle_connected = matches!(tx, Some(CarPlayUsbClientGadgetStatus::Transmitting));
+
+        Self {
+            schema_version: 1,
+            engine: "catplay",
+            lifecycle: lifecycle_name(lifecycle),
+            wireless_listener_ready,
+            wired_endpoint_ready,
+            iphone_connected,
+            vehicle_connected,
+            bridge_active: iphone_connected && vehicle_connected,
+        }
+    }
+}
+
+fn lifecycle_name(state: TelemetryLifecycle) -> &'static str {
+    match state {
+        TelemetryLifecycle::State(ProdGadgetState::Initial) => "initial",
+        TelemetryLifecycle::State(ProdGadgetState::WaitingForUdc) => "waiting_for_udc",
+        TelemetryLifecycle::State(ProdGadgetState::WaitingForUsbTransmitterGadget) => "waiting_for_usb_transmitter_gadget",
+        TelemetryLifecycle::State(ProdGadgetState::WaitingForWirelessCarPlayGadget) => "waiting_for_wireless_carplay_gadget",
+        TelemetryLifecycle::State(ProdGadgetState::WaitingForCar) => "waiting_for_car",
+        TelemetryLifecycle::State(ProdGadgetState::WaitingForIPhone) => "waiting_for_iphone",
+        TelemetryLifecycle::State(ProdGadgetState::Running) => "running",
+        TelemetryLifecycle::Error => "error",
+    }
+}
+
+struct TelemetryClient {
+    stream: UnixStream,
+    // A client never owns more than one complete line. A partial write is evicted
+    // rather than mixing an old prefix with a newer snapshot.
+    pending: Option<Vec<u8>>,
+    blocked_since: Option<Instant>,
+    would_block_retries: u8,
+}
+
+impl TelemetryClient {
+    fn replace_pending(&mut self, line: &[u8]) {
+        self.pending = Some(line.to_vec());
+    }
+
+    fn record_would_block(&mut self, now: Instant) -> bool {
+        let blocked_since = self.blocked_since.get_or_insert(now);
+        self.would_block_retries = self.would_block_retries.saturating_add(1);
+        self.would_block_retries >= MAX_WOULD_BLOCK_RETRIES
+            || now.saturating_duration_since(*blocked_since) >= SLOW_CLIENT_DEADLINE
+    }
+
+    fn clear_blocked(&mut self) {
+        self.blocked_since = None;
+        self.would_block_retries = 0;
+    }
+}
+
+pub struct TelemetryServer {
+    listener: StdUnixListener,
+    path: PathBuf,
+    dev: u64,
+    ino: u64,
+    clients: Vec<TelemetryClient>,
+    latest: Vec<u8>,
+    last_publish: Instant,
+}
+
+impl TelemetryServer {
+    pub fn bind_from_env() -> io::Result<Self> {
+        let path = std::env::var_os("CP_TELEMETRY_SOCKET")
+            .map(PathBuf::from)
+            .unwrap_or_else(|| PathBuf::from(DEFAULT_SOCKET));
+        Self::bind(&path)
+    }
+
+    pub fn bind(path: &Path) -> io::Result<Self> {
+        prepare_socket_path(path)?;
+        let listener = StdUnixListener::bind(path)?;
+        fs::set_permissions(path, fs::Permissions::from_mode(0o600))?;
+        listener.set_nonblocking(true)?;
+        let metadata = fs::symlink_metadata(path)?;
+        if !metadata.file_type().is_socket() {
+            return Err(io::Error::new(ErrorKind::Other, "telemetry bind did not create a socket"));
+        }
+        let latest = encode_line(&TelemetrySnapshot::initial())?;
+        Ok(Self {
+            listener,
+            path: path.to_owned(),
+            dev: metadata.dev(),
+            ino: metadata.ino(),
+            clients: Vec::with_capacity(MAX_CLIENTS),
+            latest,
+            last_publish: Instant::now(),
+        })
+    }
+
+    pub fn publish(&mut self, snapshot: &TelemetrySnapshot) -> io::Result<()> {
+        let line = encode_line(snapshot)?;
+        if line != self.latest || self.last_publish.elapsed() >= HEARTBEAT {
+            self.latest = line;
+            self.last_publish = Instant::now();
+            for client in &mut self.clients {
+                client.replace_pending(&self.latest);
+            }
+        }
+        self.service();
+        Ok(())
+    }
+
+    fn service(&mut self) {
+        for _ in 0..MAX_ACCEPT_ATTEMPTS_PER_SERVICE {
+            match self.listener.accept() {
+                Ok((stream, _)) if self.clients.len() < MAX_CLIENTS => {
+                    if stream.set_nonblocking(true).is_err() {
+                        continue;
+                    }
+                    let Ok(stream) = UnixStream::from_std(stream) else {
+                        continue;
+                    };
+                    self.clients.push(TelemetryClient {
+                        stream,
+                        pending: Some(self.latest.clone()),
+                        blocked_since: None,
+                        would_block_retries: 0,
+                    });
+                }
+                // Accept and immediately close excess peers so they cannot remain
+                // queued in the kernel while the four slots are occupied.
+                Ok((_stream, _)) => {}
+                Err(err) if err.kind() == ErrorKind::WouldBlock => break,
+                Err(_) => break,
+            }
+        }
+
+        let mut index = 0;
+        while index < self.clients.len() {
+            let now = Instant::now();
+            let client = &mut self.clients[index];
+            let write = client
+                .pending
+                .as_ref()
+                .map(|line| (client.stream.try_write(line), line.len()));
+            let remove = match write {
+                None => false,
+                Some((Ok(0), _)) => true,
+                Some((Ok(written), line_len)) if written == line_len => {
+                    client.pending = None;
+                    client.clear_blocked();
+                    false
+                }
+                Some((Ok(_), _)) => true,
+                // A peer which never drains must not consume one of the four
+                // slots forever. The retry count bounds eviction even if the
+                // monotonic clock is not observed past the deadline yet.
+                Some((Err(err), _)) if err.kind() == ErrorKind::WouldBlock => {
+                    client.record_would_block(now)
+                }
+                Some((Err(_), _)) => true,
+            };
+            if remove {
+                self.clients.swap_remove(index);
+            } else {
+                index += 1;
+            }
+        }
+    }
+
+    #[cfg(test)]
+    fn client_count(&self) -> usize {
+        self.clients.len()
+    }
+}
+
+impl Drop for TelemetryServer {
+    fn drop(&mut self) {
+        let Ok(metadata) = fs::symlink_metadata(&self.path) else {
+            return;
+        };
+        if metadata.file_type().is_socket() && metadata.dev() == self.dev && metadata.ino() == self.ino {
+            let _ = fs::remove_file(&self.path);
+        }
+    }
+}
+
+fn prepare_socket_path(path: &Path) -> io::Result<()> {
+    let parent = path
+        .parent()
+        .filter(|parent| !parent.as_os_str().is_empty())
+        .ok_or_else(|| io::Error::new(ErrorKind::InvalidInput, "telemetry socket has no parent directory"))?;
+    let parent_metadata = fs::symlink_metadata(parent)?;
+    if parent_metadata.file_type().is_symlink() || !parent_metadata.is_dir() {
+        return Err(io::Error::new(
+            ErrorKind::PermissionDenied,
+            "telemetry socket parent must be an existing non-symlink directory",
+        ));
+    }
+
+    match fs::symlink_metadata(path) {
+        Ok(metadata) if metadata.file_type().is_socket() && metadata.uid() == unsafe { libc::geteuid() } => fs::remove_file(path),
+        Ok(metadata) if metadata.file_type().is_socket() => Err(io::Error::new(
+            ErrorKind::PermissionDenied,
+            "refusing to remove telemetry socket owned by another uid",
+        )),
+        Ok(_) => Err(io::Error::new(
+            ErrorKind::AlreadyExists,
+            "refusing to replace non-socket telemetry path",
+        )),
+        Err(err) if err.kind() == ErrorKind::NotFound => Ok(()),
+        Err(err) => Err(err),
+    }
+}
+
+fn encode_line(snapshot: &TelemetrySnapshot) -> io::Result<Vec<u8>> {
+    let mut line = serde_json::to_vec(snapshot).map_err(io::Error::other)?;
+    line.push(b'\n');
+    if line.len() > MAX_LINE {
+        return Err(io::Error::new(ErrorKind::InvalidData, "telemetry line exceeds 4096 bytes"));
+    }
+    Ok(line)
+}
+
+#[cfg(test)]
+mod tests {
+    use std::{
+        fs,
+        os::unix::{
+            fs::{symlink, PermissionsExt},
+            net::UnixListener as StdUnixListener,
+        },
+        path::PathBuf,
+        sync::atomic::{AtomicUsize, Ordering},
+    };
+
+    use super::*;
+
+    static NEXT_TEST_PATH: AtomicUsize = AtomicUsize::new(0);
+
+    fn test_path(name: &str) -> PathBuf {
+        let id = NEXT_TEST_PATH.fetch_add(1, Ordering::Relaxed);
+        std::env::temp_dir().join(format!("catplay-telemetry-{}-{}-{id}", std::process::id(), name))
+    }
+
+    fn cleanup(path: &Path) {
+        let _ = fs::remove_file(path);
+        let _ = fs::remove_dir(path);
+    }
+
+    #[test]
+    fn false_readiness_before_real_gadget_states() {
+        let snapshot = TelemetrySnapshot::from_gadget_states(TelemetryLifecycle::from(&ProdGadgetState::Initial), Some(&CarPlayUsbClientGadgetStatus::Initial), None);
+        assert_eq!(snapshot.lifecycle, "initial");
+        assert!(!snapshot.wireless_listener_ready);
+        assert!(!snapshot.wired_endpoint_ready);
+        assert!(!snapshot.iphone_connected);
+        assert!(!snapshot.vehicle_connected);
+        assert!(!snapshot.bridge_active);
+    }
+
+    #[test]
+    fn running_requires_real_tx_and_rx() {
+        let waiting = TelemetrySnapshot::from_gadget_states(
+            TelemetryLifecycle::from(&ProdGadgetState::Running),
+            Some(&CarPlayUsbClientGadgetStatus::WaitingForInvite),
+            Some(&CarPlayWirelessGadgetState::Receiving),
+        );
+        assert!(waiting.wireless_listener_ready);
+        assert!(waiting.iphone_connected);
+        assert!(!waiting.vehicle_connected);
+        assert!(!waiting.bridge_active);
+
+        let active = TelemetrySnapshot::from_gadget_states(
+            TelemetryLifecycle::from(&ProdGadgetState::Running),
+            Some(&CarPlayUsbClientGadgetStatus::Transmitting),
+            Some(&CarPlayWirelessGadgetState::Receiving),
+        );
+        assert!(active.bridge_active);
+    }
+
+    #[test]
+    fn json_is_versioned_line_delimited_and_bounded() {
+        let line = encode_line(&TelemetrySnapshot::initial()).unwrap();
+        assert!(line.ends_with(b"\n"));
+        assert!(line.len() <= MAX_LINE);
+        let value: serde_json::Value = serde_json::from_slice(&line).unwrap();
+        assert_eq!(value["schema_version"], 1);
+        assert_eq!(value["engine"], "catplay");
+        assert_eq!(value["lifecycle"], "initial");
+    }
+
+    #[test]
+    fn socket_is_0600_and_stale_owned_socket_is_replaced() {
+        let dir = test_path("mode");
+        fs::create_dir(&dir).unwrap();
+        let path = dir.join("catplay.sock");
+        drop(StdUnixListener::bind(&path).unwrap());
+        let server = TelemetryServer::bind(&path).unwrap();
+        assert_eq!(fs::metadata(&path).unwrap().permissions().mode() & 0o777, 0o600);
+        drop(server);
+        assert!(!path.exists());
+        cleanup(&dir);
+    }
+
+    #[test]
+    fn symlink_parent_is_rejected() {
+        let dir = test_path("symlink-parent");
+        let target = test_path("symlink-target");
+        fs::create_dir(&dir).unwrap();
+        fs::create_dir(&target).unwrap();
+        let link = dir.join("link");
+        symlink(&target, &link).unwrap();
+        assert_eq!(
+            TelemetryServer::bind(&link.join("catplay.sock"))
+                .err()
+                .unwrap()
+                .kind(),
+            ErrorKind::PermissionDenied
+        );
+        cleanup(&link);
+        cleanup(&target);
+        cleanup(&dir);
+    }
+
+    #[test]
+    fn replacement_path_is_not_unlinked_on_drop() {
+        let dir = test_path("inode");
+        fs::create_dir(&dir).unwrap();
+        let path = dir.join("catplay.sock");
+        let server = TelemetryServer::bind(&path).unwrap();
+        fs::remove_file(&path).unwrap();
+        let replacement = StdUnixListener::bind(&path).unwrap();
+        drop(server);
+        assert!(path.exists());
+        drop(replacement);
+        cleanup(&path);
+        cleanup(&dir);
+    }
+
+    #[test]
+    fn non_socket_is_never_replaced() {
+        let dir = test_path("file");
+        fs::create_dir(&dir).unwrap();
+        let path = dir.join("catplay.sock");
+        fs::write(&path, b"do not replace").unwrap();
+        assert_eq!(TelemetryServer::bind(&path).err().unwrap().kind(), ErrorKind::AlreadyExists);
+        assert_eq!(fs::read(&path).unwrap(), b"do not replace");
+        cleanup(&path);
+        cleanup(&dir);
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn would_block_client_is_evicted_after_two_retries() {
+        let dir = test_path("would-block");
+        fs::create_dir(&dir).unwrap();
+        let path = dir.join("catplay.sock");
+        let mut server = TelemetryServer::bind(&path).unwrap();
+        let (stream, _peer) = UnixStream::pair().unwrap();
+        let client = TelemetryClient {
+            stream,
+            pending: Some(server.latest.clone()),
+            blocked_since: None,
+            would_block_retries: 0,
+        };
+        let filler = [0; MAX_LINE];
+        for _ in 0..1024 {
+            match client.stream.try_write(&filler) {
+                Ok(_) => continue,
+                Err(err) if err.kind() == ErrorKind::WouldBlock => break,
+                Err(err) => panic!("failed to fill test socket: {err}"),
+            }
+        }
+        assert!(matches!(client.stream.try_write(&filler), Err(err) if err.kind() == ErrorKind::WouldBlock));
+        server.clients.push(client);
+        server.service();
+        assert_eq!(server.client_count(), 1);
+        server.service();
+        assert_eq!(server.client_count(), 0);
+        drop(server);
+        cleanup(&dir);
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn client_cap_and_slow_client_keep_only_latest_unwritten_line() {
+        let dir = test_path("clients");
+        fs::create_dir(&dir).unwrap();
+        let path = dir.join("catplay.sock");
+        let mut server = TelemetryServer::bind(&path).unwrap();
+        let mut peers = Vec::new();
+        for _ in 0..MAX_CLIENTS + 1 {
+            peers.push(UnixStream::connect(&path).await.unwrap());
+        }
+        server.service();
+        assert_eq!(server.client_count(), MAX_CLIENTS);
+        tokio::time::timeout(Duration::from_secs(1), peers[MAX_CLIENTS].readable())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(peers[MAX_CLIENTS].try_read(&mut [0]).unwrap(), 0);
+
+        let (stream, _peer) = UnixStream::pair().unwrap();
+        let mut slow = TelemetryClient {
+            stream,
+            pending: Some(b"old\n".to_vec()),
+            blocked_since: None,
+            would_block_retries: 0,
+        };
+        slow.replace_pending(b"new\n");
+        assert_eq!(slow.pending.as_deref(), Some(&b"new\n"[..]));
+        let now = Instant::now();
+        assert!(!slow.record_would_block(now));
+        assert!(slow.record_would_block(now));
+        drop(peers);
+        drop(server);
+        cleanup(&dir);
+    }
+}
