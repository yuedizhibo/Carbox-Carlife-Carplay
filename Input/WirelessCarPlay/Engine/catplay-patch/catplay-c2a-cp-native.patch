+    #[test]
+    fn flush_caps_offer_and_preserves_pending_offset_after_short_writes() {
+        let dir = TempSocketDir::new();
+        let mut server = test_server(&dir);
+        let writes = Arc::new(Mutex::new(Vec::new()));
+        install_io(
+            &mut server,
+            Box::new(ShortWriter {
+                writes: writes.clone(),
+                amount: 17,
+                blocks: 0,
+            }),
+            vec![7; MAX_WRITE_BYTES_PER_SERVICE + 99],
+        );
+        server.flush();
+        assert_eq!(server.client.as_ref().unwrap().pending.as_ref().unwrap().at, 17);
+        server.flush();
+        assert_eq!(server.client.as_ref().unwrap().pending.as_ref().unwrap().at, 34);
+        assert_eq!(
+            &*writes.lock().unwrap(),
+            &[MAX_WRITE_BYTES_PER_SERVICE, MAX_WRITE_BYTES_PER_SERVICE]
+        );
+    }
