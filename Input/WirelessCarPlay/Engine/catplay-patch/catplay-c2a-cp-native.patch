+        assert_eq!(kinds.iter().filter(|&&kind| kind == AUDIO_CHUNK).count(), 8);
+        assert_eq!(kinds.iter().filter(|&&kind| kind == VIDEO_FRAME).count(), 8);
+        assert!(server.inner.video_count.load(Ordering::Acquire) <= VIDEO_CAP);
+        assert!(server.inner.audio_count.load(Ordering::Acquire) <= AUDIO_CAP);
+    }
