+    fn preloaded_refilled_video_and_audio_keep_audio_within_bounded_output_records() {
+        let dir = TempSocketDir::new();
+        let mut server = test_server(&dir);
+        let mut client = UnixStream::connect(dir.socket()).unwrap();
+        client.set_read_timeout(Some(Duration::from_millis(100))).unwrap();
+        server.service_once();
+        let _ = read_record(&mut client);
+        let m = meta();
+        server.state = Snapshot {
+            session: 7,
+            video: Some((3, 4, vec![0, 0, 0, 1, 0x67, 0, 0, 0, 1, 0x68], 640, 480)),
