+    #[test]
+    fn heartbeat_keeps_zero_sequence_and_monotonic_timestamp() {
+        let a = record(HEARTBEAT_RECORD, 0, 7, 0, 0, monotonic_us(), &[], [0; 4]);
+        let b = record(HEARTBEAT_RECORD, 0, 7, 0, 0, monotonic_us(), &[], [0; 4]);
+        assert_eq!(u64be(&a[24..32]), 0);
+        assert!(u64be(&b[32..40]) >= u64be(&a[32..40]));
+    }
