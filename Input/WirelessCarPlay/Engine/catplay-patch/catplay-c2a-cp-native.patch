+        let mut kinds = Vec::new();
+        for sequence in 1..=8 {
+            assert!(server.inner.video.try_send(video(sequence)).is_ok());
+            server.inner.video_count.fetch_add(1, Ordering::AcqRel);
+            assert!(server
+                .inner
+                .audio
+                .try_send(Audio {
+                    session: 7,
+                    stream: 4,
+                    sequence,
+                    meta: m,
+                    samples: vec![1; 32],
