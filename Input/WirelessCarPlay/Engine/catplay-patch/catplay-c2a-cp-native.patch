diff --git a/c2a/catplay_c2a/src/media_ipc.rs b/c2a/catplay_c2a/src/media_ipc.rs
new file mode 100644
index 0000000..f4a6b6a
--- /dev/null
+++ b/c2a/catplay_c2a/src/media_ipc.rs
@@ -0,0 +1,1229 @@
+use std::{
+    collections::VecDeque,
+    fs,
+    io::{self, ErrorKind, Read, Write},
+    os::unix::{
+        fs::{FileTypeExt, MetadataExt, PermissionsExt},
+        io::AsRawFd,
+        net::{UnixListener, UnixStream},
+    },
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicBool, AtomicU32, AtomicU64, AtomicUsize, Ordering},
+        mpsc::{self, Receiver, SyncSender, TryRecvError, TrySendError},
+        Arc, Mutex,
+    },
+    time::{Duration, Instant},
+};
+
+use catplay_carplay::{
+    audio::{AudioCodec, AudioStreamBasicDescription},
+    carplay_rx::AirPlayReceiverHandleRef,
+    msg::{AudioFormat, AudioType, StreamType},
+    video::{AvccConfigExtended, EncodedVideoFrame},
+};
+use log::warn;
+
+const SOCKET: &str = "/run/zero2w/catplay-media-v1.sock";
+const HEADER: usize = 64;
+const MAX_PAYLOAD: usize = 1_048_576;
+const MAX_CONFIG: usize = 65_536;
+const MAX_AUDIO: usize = 3_840;
+const VIDEO_CAP: usize = 2;
+const AUDIO_CAP: usize = 8;
+const CONTROL_CAP: usize = 16;
+const HEARTBEAT: Duration = Duration::from_secs(1);
+const WRITE_DEADLINE: Duration = Duration::from_millis(100);
+const KEYFRAME_INTERVAL: Duration = Duration::from_millis(500);
+const MAX_ACCEPTS_PER_SERVICE: usize = 2;
+const MAX_CONTROL_PER_SERVICE: usize = 4;
+const MAX_VIDEO_PER_SERVICE: usize = 1;
+const MAX_AUDIO_PER_SERVICE: usize = 1;
+/// At a 3 ms current-thread cadence this limits a healthy consumer write offer to 64 KiB.
+const MAX_WRITE_BYTES_PER_SERVICE: usize = 64 * 1024;
+
+const SESSION_BEGIN: u16 = 0x0003;
+const SESSION_END: u16 = 0x0004;
+const VIDEO_START: u16 = 0x0010;
+const VIDEO_CONFIG: u16 = 0x0011;
+const VIDEO_FRAME: u16 = 0x0012;
+const VIDEO_END: u16 = 0x0013;
+const AUDIO_START: u16 = 0x0020;
+const AUDIO_CHUNK: u16 = 0x0021;
+const AUDIO_END: u16 = 0x0022;
+const SERVER_HELLO: u16 = 0x0001;
+const HEARTBEAT_RECORD: u16 = 0x0002;
+const REQUEST_KEYFRAME: u16 = 0x8001;
+const KEYFRAME: u16 = 1;
+const DISCONTINUITY: u16 = 2;
+
+#[derive(Clone)]
+pub struct MediaTap {
+    inner: Arc<Inner>,
+}
+pub struct VideoTap {
+    tap: MediaTap,
+    session: u64,
+    stream: u32,
+    sequence: AtomicU64,
+    config_id: AtomicU32,
+}
+pub struct AudioTap {
+    tap: MediaTap,
+    session: u64,
+    stream: u32,
+    sequence: AtomicU64,
+    meta: AudioMeta,
+    ended: AtomicBool,
+}
+#[derive(Clone, Copy)]
+pub struct AudioMeta {
+    pub stream_type: StreamType,
+    pub audio_type: AudioType,
+    pub audio_format: AudioFormat,
+    pub pcm: AudioStreamBasicDescription,
+    pub latency_us: u32,
+    pub duplex: bool,
+}
+
+enum Control {
+    SessionBegin(u64),
+    SessionEnd(u64, u32),
+    VideoStart(u64, u32),
+    VideoConfig(u64, u32, u32, AvccConfigExtended),
+    VideoEnd(u64, u32, u32),
+    AudioStart(u64, u32, AudioMeta),
+    AudioEnd(u64, u32, u32),
+}
+struct Video {
+    session: u64,
+    stream: u32,
+    sequence: u64,
+    config: u32,
+    frame: EncodedVideoFrame,
+    discontinuity: bool,
+}
+struct Audio {
+    session: u64,
+    stream: u32,
+    sequence: u64,
+    meta: AudioMeta,
+    samples: Vec<i16>,
+    discontinuity: bool,
+}
+struct Inner {
+    control: SyncSender<Control>,
+    control_rx: Mutex<Receiver<Control>>,
+    control_count: AtomicUsize,
+    video: SyncSender<Video>,
+    video_rx: Mutex<Receiver<Video>>,
+    video_count: AtomicUsize,
+    audio: SyncSender<Audio>,
+    audio_rx: Mutex<Receiver<Audio>>,
+    audio_count: AtomicUsize,
+    connected: AtomicBool,
+    fatal: AtomicBool,
+    session: AtomicU64,
+    next_stream: AtomicU32,
+    handle: Mutex<Option<AirPlayReceiverHandleRef>>,
+    last_keyframe: Mutex<Instant>,
+}
+
+impl MediaTap {
+    pub fn new() -> (MediaServer, Self) {
+        let (control, control_rx) = mpsc::sync_channel(CONTROL_CAP);
+        let (video, video_rx) = mpsc::sync_channel(VIDEO_CAP);
+        let (audio, audio_rx) = mpsc::sync_channel(AUDIO_CAP);
+        let inner = Arc::new(Inner {
+            control,
+            control_rx: Mutex::new(control_rx),
+            control_count: AtomicUsize::new(0),
+            video,
+            video_rx: Mutex::new(video_rx),
+            video_count: AtomicUsize::new(0),
+            audio,
+            audio_rx: Mutex::new(audio_rx),
+            audio_count: AtomicUsize::new(0),
+            connected: AtomicBool::new(false),
+            fatal: AtomicBool::new(false),
+            session: AtomicU64::new(0),
+            next_stream: AtomicU32::new(1),
+            handle: Mutex::new(None),
+            last_keyframe: Mutex::new(Instant::now() - KEYFRAME_INTERVAL),
+        });
+        (
+            MediaServer::bind_from_env(inner.clone()).expect("media socket bind failed"),
+            Self { inner },
+        )
+    }
+    fn control(&self, event: Control) {
+        if self
+            .inner
+            .control_count
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| (n < CONTROL_CAP).then_some(n + 1))
+            .is_err()
+        {
+            self.inner.fatal.store(true, Ordering::Release);
+            return;
+        }
+        if self.inner.control.try_send(event).is_err() {
+            self.inner.control_count.fetch_sub(1, Ordering::AcqRel);
+            self.inner.fatal.store(true, Ordering::Release);
+        }
+    }
+    pub fn begin_session(&self, handle: AirPlayReceiverHandleRef) {
+        let id = self.inner.session.fetch_add(1, Ordering::AcqRel) + 1;
+        *self.inner.handle.lock().unwrap() = Some(handle);
+        self.control(Control::SessionBegin(id));
+    }
+    pub fn end_session(&self, reason: u32) {
+        let id = self.inner.session.load(Ordering::Acquire);
+        if id != 0 {
+            self.control(Control::SessionEnd(id, reason));
+        }
+        *self.inner.handle.lock().unwrap() = None;
+    }
+    pub fn video_stream(&self) -> VideoTap {
+        let session = self.inner.session.load(Ordering::Acquire);
+        let stream = self.inner.next_stream.fetch_add(1, Ordering::AcqRel);
+        self.control(Control::VideoStart(session, stream));
+        VideoTap {
+            tap: self.clone(),
+            session,
+            stream,
+            sequence: AtomicU64::new(0),
+            config_id: AtomicU32::new(0),
+        }
+    }
+    pub fn audio_stream(&self, meta: AudioMeta) -> AudioTap {
+        let session = self.inner.session.load(Ordering::Acquire);
+        let stream = self.inner.next_stream.fetch_add(1, Ordering::AcqRel);
+        self.control(Control::AudioStart(session, stream, meta));
+        AudioTap {
+            tap: self.clone(),
+            session,
+            stream,
+            sequence: AtomicU64::new(0),
+            meta,
+            ended: AtomicBool::new(false),
+        }
+    }
+    fn request_keyframe(&self) {
+        let mut last = self.inner.last_keyframe.lock().unwrap();
+        if last.elapsed() >= KEYFRAME_INTERVAL {
+            if let Some(handle) = self.inner.handle.lock().unwrap().as_ref() {
+                handle.request_keyframe();
+                *last = Instant::now();
+            }
+        }
+    }
+}
+impl VideoTap {
+    pub fn config(&self, config: AvccConfigExtended) {
+        if !valid_config(&config.avcc.sps_pps) {
+            self.tap.request_keyframe();
+            return;
+        }
+        let id = self.config_id.fetch_add(1, Ordering::AcqRel) + 1;
+        self.tap.control(Control::VideoConfig(self.session, self.stream, id, config));
+    }
+    pub fn frame(&self, frame: &EncodedVideoFrame) {
+        let sequence = self.sequence.fetch_add(1, Ordering::AcqRel) + 1;
+        if !self.tap.inner.connected.load(Ordering::Acquire) {
+            return;
+        }
+        if frame.data.len() > MAX_PAYLOAD
+            || frame.width == 0
+            || frame.height == 0
+            || frame.width > 4096
+            || frame.height > 4096
+            || (frame.width as u64 * frame.height as u64) > 8_847_360
+        {
+            self.tap.request_keyframe();
+            return;
+        }
+        if self
+            .tap
+            .inner
+            .video_count
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| (n < VIDEO_CAP).then_some(n + 1))
+            .is_err()
+        {
+            self.tap.request_keyframe();
+            return;
+        }
+        let event = Video {
+            session: self.session,
+            stream: self.stream,
+            sequence,
+            config: self.config_id.load(Ordering::Acquire),
+            frame: frame.clone(),
+            discontinuity: false,
+        };
+        if self.tap.inner.video.try_send(event).is_err() {
+            self.tap.inner.video_count.fetch_sub(1, Ordering::AcqRel);
+            self.tap.request_keyframe();
+        }
+    }
+}
+impl Drop for VideoTap {
+    fn drop(&mut self) {
+        self.tap.control(Control::VideoEnd(self.session, self.stream, 0));
+    }
+}
+impl AudioTap {
+    pub fn samples(&self, buf: &[i16]) {
+        let max_frames = self.meta.pcm.sample_rate as usize / 50;
+        let channels = self.meta.pcm.channels_per_frame as usize;
+        if channels == 0 {
+            return;
+        }
+        for chunk in buf.chunks(max_frames.saturating_mul(channels).max(channels)) {
+            let sequence = self.sequence.fetch_add(1, Ordering::AcqRel) + 1;
+            if !self.tap.inner.connected.load(Ordering::Acquire) || chunk.len() * 2 > MAX_AUDIO {
+                continue;
+            }
+            if self
+                .tap
+                .inner
+                .audio_count
+                .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| (n < AUDIO_CAP).then_some(n + 1))
+                .is_err()
+            {
+                continue;
+            }
+            let event = Audio {
+                session: self.session,
+                stream: self.stream,
+                sequence,
+                meta: self.meta,
+                samples: chunk.to_vec(),
+                discontinuity: false,
+            };
+            if self.tap.inner.audio.try_send(event).is_err() {
+                self.tap.inner.audio_count.fetch_sub(1, Ordering::AcqRel);
+            }
+        }
+    }
+    pub fn end(&self, reason: u32) {
+        if !self.ended.swap(true, Ordering::AcqRel) {
+            self.tap.control(Control::AudioEnd(self.session, self.stream, reason));
+        }
+    }
+}
+impl Drop for AudioTap {
+    fn drop(&mut self) {
+        self.end(0);
+    }
+}
+
+pub struct MediaServer {
+    listener: UnixListener,
+    path: PathBuf,
+    dev: u64,
+    ino: u64,
+    inner: Arc<Inner>,
+    client: Option<Client>,
+    state: Snapshot,
+    last_heartbeat: Instant,
+    prefer_audio: bool,
+    #[cfg(test)]
+    last_request: Option<(u64, u32)>,
+}
+trait ClientIo: Read + Write + Send {}
+impl<T: Read + Write + Send> ClientIo for T {}
+struct Client {
+    io: Box<dyn ClientIo>,
+    pending: Option<Pending>,
+    queue: VecDeque<Vec<u8>>,
+    read: Vec<u8>,
+    eagain: u8,
+}
+struct Pending {
+    data: Vec<u8>,
+    at: usize,
+    started: Instant,
+}
+#[derive(Default)]
+struct Snapshot {
+    session: u64,
+    video: Option<(u32, u32, Vec<u8>, u32, u32)>,
+    audio: Vec<(u32, AudioMeta)>,
+}
+impl MediaServer {
+    fn bind_from_env(inner: Arc<Inner>) -> io::Result<Self> {
+        let path = std::env::var_os("CP_CATPLAY_MEDIA_SOCKET")
+            .map(PathBuf::from)
+            .unwrap_or_else(|| PathBuf::from(SOCKET));
+        prepare(&path)?;
+        let listener = UnixListener::bind(&path)?;
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600))?;
+        listener.set_nonblocking(true)?;
+        let m = fs::symlink_metadata(&path)?;
+        Ok(Self {
+            listener,
+            path,
+            dev: m.dev(),
+            ino: m.ino(),
+            inner,
+            client: None,
+            state: Snapshot::default(),
+            last_heartbeat: Instant::now(),
+            prefer_audio: false,
+            #[cfg(test)]
+            last_request: None,
+        })
+    }
+    pub fn service_once(&mut self) {
+        if self.inner.fatal.swap(false, Ordering::AcqRel) {
+            self.close();
+        }
+        self.accept();
+        self.read_request();
+        self.drain();
+        if self.client.is_some() && self.last_heartbeat.elapsed() >= HEARTBEAT {
+            self.enqueue(record(HEARTBEAT_RECORD, 0, self.state.session, 0, 0, monotonic_us(), &[], [0; 4]));
+            self.last_heartbeat = Instant::now();
+        }
+        self.flush();
+    }
+    fn accept(&mut self) {
+        for _ in 0..MAX_ACCEPTS_PER_SERVICE {
+            match self.listener.accept() {
+                Ok((stream, _)) => {
+                    if self.client.is_some()
+                        || !accepts_peer_uid(peer_uid(&stream).ok(), unsafe { libc::geteuid() })
+                        || stream.set_nonblocking(true).is_err()
+                    {
+                        continue;
+                    }
+                    self.inner.connected.store(true, Ordering::Release);
+                    self.client = Some(Client {
+                        io: Box::new(stream),
+                        pending: None,
+                        queue: VecDeque::with_capacity(CONTROL_CAP),
+                        read: Vec::with_capacity(HEADER),
+                        eagain: 0,
+                    });
+                    self.enqueue(hello());
+                    self.snapshot();
+                    self.request_keyframe();
+                }
+                Err(e) if e.kind() == ErrorKind::WouldBlock => break,
+                Err(_) => break,
+            }
+        }
+    }
+    fn close(&mut self) {
+        self.client = None;
+        self.inner.connected.store(false, Ordering::Release);
+    }
+    fn enqueue(&mut self, data: Vec<u8>) {
+        if let Some(c) = self.client.as_mut() {
+            if c.pending.is_none() {
+                c.pending = Some(Pending {
+                    data,
+                    at: 0,
+                    started: Instant::now(),
+                });
+            } else if c.queue.len() < CONTROL_CAP {
+                c.queue.push_back(data);
+            } else {
+                self.close();
+            }
+        }
+    }
+    fn drain(&mut self) {
+        for _ in 0..MAX_CONTROL_PER_SERVICE {
+            let event = { self.inner.control_rx.lock().unwrap().try_recv() };
+            match event {
+                Ok(e) => {
+                    self.inner.control_count.fetch_sub(1, Ordering::AcqRel);
+                    self.control_event(e);
+                }
+                Err(TryRecvError::Empty | TryRecvError::Disconnected) => break,
+            }
+        }
+        self.prefer_audio = !self.prefer_audio;
+        for audio_first in queue_order(self.prefer_audio) {
+            if audio_first {
+                for _ in 0..MAX_AUDIO_PER_SERVICE {
+                    let event = { self.inner.audio_rx.lock().unwrap().try_recv().ok() };
+                    let Some(e) = event else { break };
+                    self.inner.audio_count.fetch_sub(1, Ordering::AcqRel);
+                    self.audio_event(e);
+                }
+            } else {
+                for _ in 0..MAX_VIDEO_PER_SERVICE {
+                    let event = { self.inner.video_rx.lock().unwrap().try_recv().ok() };
+                    let Some(e) = event else { break };
+                    self.inner.video_count.fetch_sub(1, Ordering::AcqRel);
+                    self.video_event(e);
+                }
+            }
+        }
+    }
+    fn control_event(&mut self, e: Control) {
+        match e {
+            Control::SessionBegin(id) => {
+                self.state = Snapshot {
+                    session: id,
+                    ..Default::default()
+                };
+                self.enqueue(record(SESSION_BEGIN, 0, id, 0, 0, 0, &[], [0; 4]));
+            }
+            Control::SessionEnd(id, reason) => {
+                if self.state.session == id {
+                    self.enqueue(record(SESSION_END, 0, id, 0, 0, 0, &[], [reason, 0, 0, 0]));
+                    self.state = Snapshot::default();
+                }
+            }
+            Control::VideoStart(s, st) => self.enqueue(record(VIDEO_START, 0, s, st, 0, 0, &[], [0; 4])),
+            Control::VideoConfig(s, st, id, cfg) => {
+                let bytes = cfg.avcc.sps_pps;
+                if !valid_config(&bytes) {
+                    self.enqueue(record(VIDEO_CONFIG, 0, s, st, 0, 0, &[], [0, cfg.width, cfg.height, id]));
+                } else {
+                    self.state.video = Some((st, id, bytes.clone(), cfg.width, cfg.height));
+                    self.enqueue(record(VIDEO_CONFIG, 0, s, st, 0, 0, &bytes, [1, cfg.width, cfg.height, id]));
+                }
+            }
+            Control::VideoEnd(s, st, r) => self.enqueue(record(VIDEO_END, 0, s, st, 0, 0, &[], [r, 0, 0, 0])),
+            Control::AudioStart(s, st, meta) => {
+                self.state.audio.retain(|(id, _)| *id != st);
+                if self.state.audio.len() == 2 {
+                    self.state.audio.remove(0);
+                }
+                self.state.audio.push((st, meta));
+                self.enqueue(audio_start(s, st, meta, 0));
+            }
+            Control::AudioEnd(s, st, r) => {
+                self.state.audio.retain(|(id, _)| *id != st);
+                self.enqueue(record(AUDIO_END, 0, s, st, 0, 0, &[], [r, 0, 0, 0]));
+            }
+        }
+    }
+    fn video_event(&mut self, e: Video) {
+        if self.state.session != e.session || self.state.video.as_ref().map(|v| v.0) != Some(e.stream) || e.config == 0 {
+            return;
+        }
+        let mut flags = if e.frame.is_known_keyframe() { KEYFRAME } else { 0 };
+        if e.discontinuity {
+            flags |= DISCONTINUITY;
+        }
+        let pts = pts_us(&e.frame);
+        self.enqueue(record(
+            VIDEO_FRAME,
+            flags,
+            e.session,
+            e.stream,
+            e.sequence,
+            pts,
+            &e.frame.data,
+            [1, e.frame.width, e.frame.height, e.config],
+        ));
+    }
+    fn audio_event(&mut self, e: Audio) {
+        if self.state.session != e.session || !valid_pcm(e.meta.pcm) {
+            return;
+        }
+        let frames = e.samples.len() / e.meta.pcm.channels_per_frame as usize;
+        let mut bytes = Vec::with_capacity(e.samples.len() * 2);
+        for v in e.samples {
+            bytes.extend_from_slice(&v.to_le_bytes());
+        }
+        let flags = if e.discontinuity { DISCONTINUITY } else { 0 };
+        self.enqueue(record(
+            AUDIO_CHUNK,
+            flags,
+            e.session,
+            e.stream,
+            e.sequence,
+            monotonic_us(),
+            &bytes,
+            [
+                audio_type(e.meta.audio_type),
+                e.meta.pcm.sample_rate,
+                e.meta.pcm.channels_per_frame,
+                frames as u32,
+            ],
+        ));
+    }
+    fn flush(&mut self) {
+        let Some(c) = self.client.as_mut() else {
+            return;
+        };
+        let Some(p) = c.pending.as_mut() else {
+            return;
+        };
+        let offer = (p.data.len() - p.at).min(MAX_WRITE_BYTES_PER_SERVICE);
+        match c.io.write(&p.data[p.at..p.at + offer]) {
+            Ok(0) => self.close(),
+            Ok(n) => {
+                p.at += n;
+                c.eagain = 0;
+                if p.at == p.data.len() {
+                    c.pending = c.queue.pop_front().map(|data| Pending {
+                        data,
+                        at: 0,
+                        started: Instant::now(),
+                    });
+                }
+            }
+            Err(e) if e.kind() == ErrorKind::WouldBlock => {
+                c.eagain += 1;
+                if c.eagain >= 2 || p.started.elapsed() >= WRITE_DEADLINE {
+                    self.close();
+                }
+            }
+            Err(_) => self.close(),
+        }
+    }
+    fn read_request(&mut self) {
+        let mut close = false;
+        let mut target = None;
+        {
+            let Some(c) = self.client.as_mut() else {
+                return;
+            };
+            let mut buf = [0; HEADER];
+            match c.io.read(&mut buf) {
+                Ok(0) => close = true,
+                Ok(n) => {
+                    c.read.extend_from_slice(&buf[..n]);
+                    if c.read.len() > HEADER {
+                        close = true;
+                    } else if c.read.len() == HEADER {
+                        target = request_target(&c.read);
+                        close = target.is_none();
+                        if !close {
+                            c.read.clear();
+                        }
+                    }
+                }
+                Err(e) if e.kind() == ErrorKind::WouldBlock => {}
+                Err(_) => close = true,
+            }
+        }
+        if close {
+            self.close();
+            return;
+        }
+        if let Some((session, stream)) = target {
+            #[cfg(test)]
+            {
+                self.last_request = Some((session, stream));
+            }
+            if session == self.state.session && self.state.video.as_ref().map(|v| v.0) == Some(stream) {
+                self.request_keyframe();
+            }
+        }
+    }
+    fn request_keyframe(&self) {
+        let mut last = self.inner.last_keyframe.lock().unwrap();
+        if last.elapsed() >= KEYFRAME_INTERVAL {
+            if let Some(h) = self.inner.handle.lock().unwrap().as_ref() {
+                h.request_keyframe();
+                *last = Instant::now();
+            }
+        }
+    }
+    fn snapshot(&mut self) {
+        let s = self.state.session;
+        if s == 0 {
+            return;
+        }
+        self.enqueue(record(SESSION_BEGIN, 4, s, 0, 0, 0, &[], [0; 4]));
+        if let Some((st, id, bytes, w, h)) = self.state.video.clone() {
+            self.enqueue(record(VIDEO_START, 4, s, st, 0, 0, &[], [0; 4]));
+            self.enqueue(record(VIDEO_CONFIG, 4, s, st, 0, 0, &bytes, [1, w, h, id]));
+        }
+        for (st, m) in self.state.audio.clone() {
+            self.enqueue(audio_start(s, st, m, 4));
+        }
+    }
+}
+impl Drop for MediaServer {
+    fn drop(&mut self) {
+        self.close();
+        if let Ok(m) = fs::symlink_metadata(&self.path) {
+            if m.file_type().is_socket() && m.dev() == self.dev && m.ino() == self.ino {
+                let _ = fs::remove_file(&self.path);
+            }
+        }
+    }
+}
+
+fn prepare(path: &Path) -> io::Result<()> {
+    let parent = path
+        .parent()
+        .filter(|p| !p.as_os_str().is_empty())
+        .ok_or_else(|| io::Error::new(ErrorKind::InvalidInput, "media socket has no parent"))?;
+    let pm = fs::symlink_metadata(parent)?;
+    if pm.file_type().is_symlink() || !pm.is_dir() {
+        return Err(io::Error::new(
+            ErrorKind::PermissionDenied,
+            "media socket parent must be existing non-symlink directory",
+        ));
+    }
+    match fs::symlink_metadata(path) {
+        Ok(m) if m.file_type().is_socket() && m.uid() == unsafe { libc::geteuid() } => fs::remove_file(path),
+        Ok(m) if m.file_type().is_socket() => Err(io::Error::new(ErrorKind::PermissionDenied, "refusing foreign media socket")),
+        Ok(_) => Err(io::Error::new(ErrorKind::AlreadyExists, "refusing non-socket media path")),
+        Err(e) if e.kind() == ErrorKind::NotFound => Ok(()),
+        Err(e) => Err(e),
+    }
+}
+fn accepts_peer_uid(uid: Option<u32>, expected: u32) -> bool {
+    uid == Some(expected)
+}
+fn queue_order(prefer_audio: bool) -> [bool; 2] {
+    [prefer_audio, !prefer_audio]
+}
+fn request_target(h: &[u8]) -> Option<(u64, u32)> {
+    if h.len() != HEADER
+        || &h[..4] != b"CPMF"
+        || h[4] != 1
+        || h[5] != 0
+        || u16be(&h[6..8]) != HEADER as u16
+        || u16be(&h[8..10]) != REQUEST_KEYFRAME
+        || h[10..12].iter().any(|b| *b != 0)
+        || h[24..].iter().any(|b| *b != 0)
+    {
+        return None;
+    }
+    Some((u64be(&h[16..24]), u32be(&h[12..16])))
+}
+fn peer_uid(s: &UnixStream) -> io::Result<u32> {
+    let mut cred = libc::ucred { pid: 0, uid: 0, gid: 0 };
+    let mut len = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    let r = unsafe {
+        libc::getsockopt(
+            s.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            (&mut cred as *mut libc::ucred).cast(),
+            &mut len,
+        )
+    };
+    if r == 0 {
+        Ok(cred.uid)
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
+fn record(kind: u16, flags: u16, session: u64, stream: u32, seq: u64, pts: u64, payload: &[u8], p: [u32; 4]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(HEADER + payload.len());
+    out.extend_from_slice(b"CPMF");
+    out.push(1);
+    out.push(0);
+    out.extend_from_slice(&(HEADER as u16).to_be_bytes());
+    out.extend_from_slice(&kind.to_be_bytes());
+    out.extend_from_slice(&flags.to_be_bytes());
+    out.extend_from_slice(&stream.to_be_bytes());
+    out.extend_from_slice(&session.to_be_bytes());
+    out.extend_from_slice(&seq.to_be_bytes());
+    out.extend_from_slice(&pts.to_be_bytes());
+    out.extend_from_slice(&(payload.len() as u32).to_be_bytes());
+    for x in p {
+        out.extend_from_slice(&x.to_be_bytes());
+    }
+    out.extend_from_slice(&0u32.to_be_bytes());
+    out.extend_from_slice(payload);
+    out
+}
+fn hello() -> Vec<u8> {
+    record(SERVER_HELLO, 0, 0, 0, 0, 0, &[], [MAX_PAYLOAD as u32, 1000, 7, 1])
+}
+fn audio_start(s: u64, st: u32, m: AudioMeta, flags: u16) -> Vec<u8> {
+    let mut d = Vec::with_capacity(16);
+    d.push(m.stream_type as u8);
+    d.push(1);
+    d.push(m.duplex as u8);
+    d.push(0);
+    d.extend_from_slice(&m.latency_us.to_be_bytes());
+    d.extend_from_slice(&m.audio_format.bits().to_be_bytes());
+    record(
+        AUDIO_START,
+        flags,
+        s,
+        st,
+        0,
+        0,
+        &d,
+        [audio_type(m.audio_type), m.pcm.sample_rate, m.pcm.channels_per_frame, 1],
+    )
+}
+fn audio_type(v: AudioType) -> u32 {
+    match v {
+        AudioType::Default => 0,
+        AudioType::Alert => 1,
+        AudioType::Media => 2,
+        AudioType::Telephony => 3,
+        AudioType::SpeechRecognition => 4,
+        AudioType::Compatibility => 5,
+    }
+}
+fn valid_pcm(p: AudioStreamBasicDescription) -> bool {
+    matches!(p.sample_rate, 8000 | 16000 | 24000 | 32000 | 44100 | 48000)
+        && matches!(p.channels_per_frame, 1 | 2)
+        && p.format == AudioCodec::LinearPcm
+        && p.format_flags.contains(catplay_carplay::audio::AudioFormatFlags::IS_SIGNED_INT)
+        && !p
+            .format_flags
+            .contains(catplay_carplay::audio::AudioFormatFlags::IS_FLOAT | catplay_carplay::audio::AudioFormatFlags::IS_NON_INTERLEAVED)
+        && p.bits_per_channel == 16
+        && p.bytes_per_frame == p.channels_per_frame * 2
+}
+fn valid_config(b: &[u8]) -> bool {
+    if b.is_empty() || b.len() > MAX_CONFIG {
+        return false;
+    }
+    let mut sps = false;
+    let mut pps = false;
+    let mut i = 0;
+    while i + 4 <= b.len() {
+        let n = if b[i..].starts_with(&[0, 0, 0, 1]) {
+            4
+        } else if b[i..].starts_with(&[0, 0, 1]) {
+            3
+        } else {
+            i += 1;
+            continue;
+        };
+        if i + n >= b.len() {
+            return false;
+        }
+        match b[i + n] & 31 {
+            7 => sps = true,
+            8 => pps = true,
+            _ => {}
+        }
+        i += n;
+    }
+    sps && pps
+}
+fn pts_us(f: &EncodedVideoFrame) -> u64 {
+    let base = monotonic_us();
+    match f.pts.decode() {
+        catplay_carplay::video::PtsDecoded::Past(d) => base.saturating_sub(d.as_micros() as u64),
+        catplay_carplay::video::PtsDecoded::Future(d) => base.saturating_add(d.as_micros() as u64),
+    }
+    .max(1)
+}
+fn monotonic_us() -> u64 {
+    static START: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+    START.get_or_init(Instant::now).elapsed().as_micros().max(1) as u64
+}
+fn u16be(b: &[u8]) -> u16 {
+    u16::from_be_bytes([b[0], b[1]])
+}
+fn u32be(b: &[u8]) -> u32 {
+    u32::from_be_bytes([b[0], b[1], b[2], b[3]])
+}
+fn u64be(b: &[u8]) -> u64 {
+    u64::from_be_bytes(b.try_into().unwrap())
+}
