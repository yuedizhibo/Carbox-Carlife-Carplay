+use std::{collections::BTreeMap, fs, path::Path};
+
+const DEFAULT_PATH: &str = "/tmp/zero2w-carplay-display.conf";
+const MAX_BYTES: u64 = 512;
+const MAX_TOTAL_PIXEL_RATE: u64 = 250_000_000;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct ScreenOffer {
+    pub enabled: bool,
+    pub width: u32,
+    pub height: u32,
+    pub fps: u32,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct DisplayConfig {
+    pub main: ScreenOffer,
+    pub alt: ScreenOffer,
+}
+
+impl Default for DisplayConfig {
+    fn default() -> Self {
+        Self {
+            main: ScreenOffer {
+                enabled: true,
+                width: 1920,
+                height: 1080,
+                fps: 60,
+            },
+            alt: ScreenOffer {
+                enabled: false,
+                width: 1280,
+                height: 720,
+                fps: 30,
+            },
+        }
+    }
+}
+
+impl DisplayConfig {
+    fn validate(self) -> Result<Self, String> {
+        fn screen(name: &str, value: ScreenOffer) -> Result<(), String> {
+            if value.width < 320
+                || value.width > 2560
+                || value.height < 240
+                || value.height > 1440
+                || value.width % 2 != 0
+                || value.height % 2 != 0
+                || !(1..=60).contains(&value.fps)
+            {
+                return Err(format!("{name} must use even 320..2560 x 240..1440 dimensions and 1..60 fps"));
+            }
+            Ok(())
+        }
+        if !self.main.enabled {
+            return Err("main display cannot be disabled".into());
+        }
+        screen("main", self.main)?;
+        screen("alt", self.alt)?;
+        let mut rate = self.main.width as u64 * self.main.height as u64 * self.main.fps as u64;
+        if self.alt.enabled {
+            rate += self.alt.width as u64 * self.alt.height as u64 * self.alt.fps as u64;
+        }
+        if rate > MAX_TOTAL_PIXEL_RATE {
+            return Err("combined display pixel rate exceeds 250000000 pixels/s".into());
+        }
+        Ok(self)
+    }
+}
+
+fn parse_bool(value: &str) -> Result<bool, String> {
+    match value {
+        "0" => Ok(false),
+        "1" => Ok(true),
+        _ => Err("alt_enabled must be 0 or 1".into()),
+    }
+}
+
+fn take_u32(values: &mut BTreeMap<&str, &str>, key: &str) -> Result<u32, String> {
+    values
+        .remove(key)
+        .ok_or_else(|| format!("missing display config key {key}"))?
+        .parse::<u32>()
+        .map_err(|_| format!("display config key {key} is not an unsigned integer"))
+}
+
+fn parse(text: &str) -> Result<DisplayConfig, String> {
+    let mut values = BTreeMap::new();
+    for line in text.lines() {
+        if line.is_empty() {
+            return Err("empty line in display config".into());
+        }
+        let (key, value) = line.split_once('=').ok_or_else(|| "invalid display config line".to_string())?;
+        if key.is_empty() || value.is_empty() || values.insert(key, value).is_some() {
+            return Err("invalid or duplicate display config key".into());
+        }
+    }
+    if take_u32(&mut values, "version")? != 1 {
+        return Err("unsupported display config version".into());
+    }
+    let config = DisplayConfig {
+        main: ScreenOffer {
+            enabled: true,
+            width: take_u32(&mut values, "main_width")?,
+            height: take_u32(&mut values, "main_height")?,
+            fps: take_u32(&mut values, "main_fps")?,
+        },
+        alt: ScreenOffer {
+            enabled: parse_bool(values.remove("alt_enabled").ok_or_else(|| "missing display config key alt_enabled".to_string())?)?,
+            width: take_u32(&mut values, "alt_width")?,
+            height: take_u32(&mut values, "alt_height")?,
+            fps: take_u32(&mut values, "alt_fps")?,
+        },
+    };
+    if !values.is_empty() {
+        return Err("unknown display config key".into());
+    }
+    config.validate()
+}
+
+pub fn load_display_config() -> Result<DisplayConfig, String> {
+    let path = std::env::var_os("CATPLAY_DISPLAY_CONFIG")
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(|| DEFAULT_PATH.into());
+    load_path(&path)
+}
+
+fn load_path(path: &Path) -> Result<DisplayConfig, String> {
+    let metadata = match fs::metadata(path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(DisplayConfig::default()),
+        Err(error) => return Err(format!("cannot stat display config: {error}")),
+    };
+    if metadata.len() > MAX_BYTES {
+        return Err("display config is too large".into());
+    }
+    let text = fs::read_to_string(path).map_err(|error| format!("cannot read display config: {error}"))?;
+    if text.len() as u64 > MAX_BYTES {
+        return Err("display config is too large".into());
+    }
+    parse(&text)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_bounded_dual_display_offer() {
+        let parsed =
+            parse("version=1\nmain_width=1280\nmain_height=720\nmain_fps=50\nalt_enabled=1\nalt_width=800\nalt_height=480\nalt_fps=25\n")
+                .unwrap();
+        assert_eq!(
+            parsed.main,
+            ScreenOffer {
+                enabled: true,
+                width: 1280,
+                height: 720,
+                fps: 50
+            }
+        );
+        assert_eq!(
+            parsed.alt,
+            ScreenOffer {
+                enabled: true,
+                width: 800,
+                height: 480,
+                fps: 25
+            }
+        );
+    }
+
+    #[test]
+    fn rejects_odd_or_excessive_offers() {
+        assert!(
+            parse("version=1\nmain_width=1279\nmain_height=720\nmain_fps=50\nalt_enabled=0\nalt_width=800\nalt_height=480\nalt_fps=25\n")
+                .is_err()
+        );
+        assert!(
+            parse(
+                "version=1\nmain_width=2560\nmain_height=1440\nmain_fps=60\nalt_enabled=1\nalt_width=2560\nalt_height=1440\nalt_fps=60\n"
+            )
+            .is_err()
+        );
+    }
+}
