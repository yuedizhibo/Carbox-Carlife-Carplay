+
+impl StartupPlan {
+    fn build(config: &AppConfig, mode: RunMode, hook: &mut impl StartupHook) -> Result<Self, String> {
+        validate_zero2w_mfi_config(config)?;
+        match mode {
+            RunMode::InputOnly => {
+                hook.observe(StartupEffect::MfiStart);
+                hook.observe(StartupEffect::HomeKitStart);
+                hook.observe(StartupEffect::MediaServer);
+                hook.observe(StartupEffect::WirelessPreview);
+            }
+            RunMode::Bridge => {
+                // Retain the legacy bridge sequence only after the same MFi
+                // guard has accepted it. The real TX gadget is lazy inside
+                // ProdGadget; this marker documents that only bridge can reach it.
+                hook.observe(StartupEffect::GadgetCleanup);
+                hook.observe(StartupEffect::GadgetCleanup);
+                hook.observe(StartupEffect::MfiStart);
+                hook.observe(StartupEffect::HomeKitStart);
+                hook.observe(StartupEffect::MediaServer);
+                hook.observe(StartupEffect::OutputManager);
+                hook.observe(StartupEffect::TxPath);
+            }
+        }
