+/// Input-only PCM is sampled at 10 ms intervals. At the supported maximum of
+/// 48 kHz stereo this is exactly 960 signed 16-bit samples, so the worker never
+/// allocates an audio buffer based on a peer-provided size.
+const PREVIEW_PCM_CADENCE: Duration = Duration::from_millis(10);
+const MAX_PREVIEW_PCM_SAMPLES: usize = 48_000 / 100 * 2;
+const MAIN_DISPLAY_UUID: &str = "5E2D6D6C-8E32-4E2A-9A74-000000001080";
+const ALT_DISPLAY_UUID: &str = "5E2D6D6C-8E32-4E2A-9A74-000000001081";
+const ALT_MAP_URL: &str = "maps:/car/instrumentcluster/map";
+pub(crate) const TOUCH_HID_UUID: &str = "5E2D6D6C-8E32-4E2A-9A74-000000001082";
+
+/// Standard single-contact digitizer descriptor. The matching input report is
+/// exactly six bytes: transducer index, touch bit + padding, X LE, Y LE.
+pub(crate) fn touch_hid_device(width: u32, height: u32) -> HidDevice {
+    let x_max = width.saturating_sub(1).min(u16::MAX as u32) as u16;
+    let y_max = height.saturating_sub(1).min(u16::MAX as u32) as u16;
+    let mut descriptor = vec![
+        0x05, 0x0d, 0x09, 0x04, 0xa1, 0x01, // Digitizer / Touch Screen / Application
+        0x09, 0x22, 0xa1, 0x02, // Finger / Logical
+        0x09, 0x38, 0x75, 0x08, 0x95, 0x01, 0x81, 0x02, // Transducer index, 8 bits
+        0x15, 0x00, 0x25, 0x01, 0x09, 0x33, 0x75, 0x01, 0x95, 0x01, 0x81, 0x02, // Touch
+        0x95, 0x07, 0x81, 0x03, // Padding
+        0x05, 0x01, 0x26,
+    ];
+    descriptor.extend_from_slice(&x_max.to_le_bytes());
+    descriptor.extend_from_slice(&[0x09, 0x30, 0x75, 0x10, 0x95, 0x01, 0x81, 0x02, 0x26]);
+    descriptor.extend_from_slice(&y_max.to_le_bytes());
+    descriptor.extend_from_slice(&[0x09, 0x31, 0x81, 0x02, 0xc0, 0xc0]);
+    HidDevice {
+        display_uuid: MAIN_DISPLAY_UUID.into(),
+        hid_country_code: 0,
+        hid_descriptor: descriptor.into(),
+        hid_product_id: 1,
+        hid_vendor_id: 2,
+        name: "Zero2W CarPlay Touchscreen".into(),
+        uuid: TOUCH_HID_UUID.into(),
+    }
+}
+
+pub(crate) fn touch_report(down: bool, x: u16, y: u16) -> [u8; 6] {
+    [0, u8::from(down), x as u8, (x >> 8) as u8, y as u8, (y >> 8) as u8]
+}
+
+/// A standalone, receive-only CarPlay session.
+///
+/// This type deliberately has no vehicle, transmitter, HID, microphone, or
+/// secondary-display path. It supplies exactly one primary display and sends
+/// only phone-to-accessory H.264 and PCM playback data to the bounded CPMF tap.
+pub struct PreviewRxSession {
+    media: MediaTap,
+    handle: Option<AirPlayReceiverHandleRef>,
+    /// The epoch returned when this exact receiver owner began. Keeping it on
+    /// the owner prevents a delayed old Drop from clearing a newer session.
+    session_epoch: Option<u64>,
+    display_config: DisplayConfig,
+}
+
+impl PreviewRxSession {
+    pub fn new(media: MediaTap) -> Self {
+        Self {
+            media,
+            handle: None,
+            session_epoch: None,
+            display_config: DisplayConfig::default(),
+        }
+    }
+
+    fn finish_session(&mut self, reason: u32) {
+        self.handle.take();
+        if let Some(epoch) = self.session_epoch.take() {
+            self.media.end_session_for_epoch(epoch, reason);
+        }
+    }
+
+    fn pcm_samples_per_tick(pcm: AudioStreamBasicDescription) -> RtspResult<usize> {
+        if !matches!(pcm.sample_rate, 8_000 | 16_000 | 24_000 | 32_000 | 44_100 | 48_000)
+            || !matches!(pcm.channels_per_frame, 1 | 2)
+            || pcm.format != AudioCodec::LinearPcm
+            || !pcm.format_flags.contains(AudioFormatFlags::IS_SIGNED_INT)
+            || pcm.format_flags.intersects(AudioFormatFlags::IS_FLOAT | AudioFormatFlags::IS_NON_INTERLEAVED)
+            || pcm.bits_per_channel != 16
+            || pcm.bytes_per_frame != pcm.channels_per_frame * 2
+        {
+            return Err(RtspError::NotSupported);
+        }
+        let samples = (pcm.sample_rate as usize / 100).saturating_mul(pcm.channels_per_frame as usize);
+        if samples == 0 || samples > MAX_PREVIEW_PCM_SAMPLES {
+            return Err(RtspError::NotSupported);
+        }
+        Ok(samples)
+    }
+
+    #[cfg(test)]
+    fn test_begin_session(&mut self) -> u64 {
+        let epoch = self.media.test_begin_session();
+        self.session_epoch = Some(epoch);
+        epoch
+    }
+
+    fn has_session(&self) -> bool {
+        self.session_epoch.is_some()
+    }
+
+    fn display(offer: ScreenOffer, uuid: &str, stream_type: StreamType) -> Display {
+        Display {
+            stream_type,
+            features: if stream_type == StreamType::Screen { DisplayFeature::HIGHFI_TOUCH } else { DisplayFeature::empty() },
+            primary_input_device: (stream_type == StreamType::Screen).then_some(PrimaryInputDevice::TouchScreen),
+            max_fps: Some(offer.fps),
+            height_pixels: offer.height,
+            width_pixels: offer.width,
+            height_physical: (offer.height.saturating_mul(194) / 1080).max(1),
+            width_physical: (offer.width.saturating_mul(344) / 1920).max(1),
+            uuid: uuid.into(),
+            view_areas: vec![DisplayViewArea {
+                height_pixels: offer.height,
+                width_pixels: offer.width,
+                origin_x_pixels: 0,
+                origin_y_pixels: 0,
+                safe_area: Some(DisplaySafeArea {
+                    height_pixels: offer.height,
+                    width_pixels: offer.width,
+                    origin_x_pixels: 0,
+                    origin_y_pixels: 0,
+                }),
+            }],
+            initial_view_area: Some(0),
+            ..Display::default()
+        }
+    }
+
+    fn apply_display_config(info: &mut InfoMessageResponse, config: DisplayConfig) {
+        info.displays.clear();
+        info.displays.push(Self::display(config.main, MAIN_DISPLAY_UUID, StreamType::Screen));
+        if config.alt.enabled {
+            info.displays.push(Self::display(config.alt, ALT_DISPLAY_UUID, StreamType::AltScreen));
+        }
+    }
+}
+
+#[async_trait]
+impl AirPlayReceiverSink for PreviewRxSession {
+    fn init(&mut self, session: AirPlayReceiverHandleRef) -> RtspResult<()> {
+        self.handle = Some(session.clone());
+        self.session_epoch = Some(self.media.begin_session(session));
+        Ok(())
+    }
+
+    async fn on_initial_setup(&mut self) -> RtspResult<()> {
+        if !self.has_session() {
+            return Err(RtspError::UnexpectedState("preview session was not initialized".into()));
+        }
+        self.display_config = load_display_config().unwrap_or_else(|error| {
+            warn!("Rejected display configuration, using safe defaults: {error}");
+            DisplayConfig::default()
+        });
+        Ok(())
+    }
+
+    fn enabled_features(&self) -> Vec<ControllerFeature> {
+        let mut features = vec![ControllerFeature::ViewAreas];
+        if self.display_config.alt.enabled {
+            features.push(ControllerFeature::AltScreen);
+        }
+        features
+    }
+
+    async fn on_command_raw(&mut self, command: &Command) -> RtspResult<RtspResponse> {
+        match command {
+            Command::DuckAudio(value) => self.media.set_audio_gain_db(value.duration_ms, value.volume),
+            Command::UnduckAudio(value) => self.media.set_audio_gain_db(value.duration_ms, value.volume),
+            _ => {}
+        }
+        Ok(RtspResponse::new(None, HttpStatus::Ok))
+    }
+
+    async fn on_info(&mut self, info: &mut InfoMessageResponse) {
+        // Configuration is only an offer. Actual main/alt activity is derived
+        // later from independent RTSP/CPMF streams and is never inferred here.
+        let config = load_display_config().unwrap_or_else(|error| {
+            warn!("Rejected display configuration, using safe defaults: {error}");
+            DisplayConfig::default()
+        });
+        self.display_config = config;
+        Self::apply_display_config(info, config);
+        let touch = touch_hid_device(config.main.width, config.main.height);
+        self.media.set_touch_device(touch.clone());
+        info.hid_devices.clear();
+        info.hid_devices.push(touch);
+    }
+
+    async fn on_record(&mut self) -> RtspResult<()> {
+        let handle = self
+            .handle
+            .as_ref()
+            .ok_or_else(|| RtspError::UnexpectedState("preview session was not initialized".into()))?;
+        handle.request_ui_for_display(MAIN_DISPLAY_UUID, "");
+        handle.request_keyframe_for_display(MAIN_DISPLAY_UUID);
+        if self.display_config.alt.enabled {
+            handle.show_ui_for_display(ALT_DISPLAY_UUID, ALT_MAP_URL);
+            handle.request_keyframe_for_display(ALT_DISPLAY_UUID);
+        }
+        Ok(())
+    }
+
+    async fn open_screen(&mut self, _latency: Duration) -> RtspResult<ScreenReceiverSinkBox> {
+        if !self.has_session() {
+            return Err(RtspError::UnexpectedState("preview session was not initialized".into()));
+        }
+        if let Some(handle) = self.handle.as_ref() {
+            handle.request_ui_for_display(MAIN_DISPLAY_UUID, "");
+            handle.request_keyframe_for_display(MAIN_DISPLAY_UUID);
+        }
+        Ok(Box::new(PreviewScreen::new(self.media.video_stream(VideoRole::Main))))
+    }
+
+    async fn open_screen_for_display(
+        &mut self,
+        _latency: Duration,
+        stream_type: StreamType,
+        display_uuid: Option<&str>,
+    ) -> RtspResult<ScreenReceiverSinkBox> {
+        if !self.has_session() {
+            return Err(RtspError::UnexpectedState("preview session was not initialized".into()));
+        }
+        let role = match (stream_type, display_uuid) {
+            (StreamType::Screen, Some(ALT_DISPLAY_UUID)) | (StreamType::AltScreen, _) => VideoRole::Alt,
+            (StreamType::Screen, _) => VideoRole::Main,
+            _ => return Err(RtspError::NotSupported),
+        };
+        if role == VideoRole::Alt && !self.display_config.alt.enabled {
+            return Err(RtspError::NotSupported);
+        }
+        if matches!((role, display_uuid), (VideoRole::Main, Some(ALT_DISPLAY_UUID)) | (VideoRole::Alt, Some(MAIN_DISPLAY_UUID))) {
+            return Err(RtspError::NotSupported);
+        }
+        if let Some(handle) = self.handle.as_ref() {
+            match role {
+                VideoRole::Main => {
+                    handle.request_ui_for_display(MAIN_DISPLAY_UUID, "");
+                    handle.request_keyframe_for_display(MAIN_DISPLAY_UUID);
+                }
+                VideoRole::Alt => {
+                    handle.show_ui_for_display(ALT_DISPLAY_UUID, ALT_MAP_URL);
+                    handle.request_keyframe_for_display(ALT_DISPLAY_UUID);
+                }
+            }
+        }
+        Ok(Box::new(PreviewScreen::new(self.media.video_stream(role))))
+    }
+
+    async fn open_audio(
+        &mut self,
+        latency: Duration,
+        stream_type: StreamType,
+        audio_type: AudioType,
+        audio_format: AudioFormat,
+        pcm_format: AudioStreamBasicDescription,
+        duplex: bool,
+    ) -> RtspResult<AudioPlayerBox<i16>> {
+        if !self.has_session() {
+            return Err(RtspError::UnexpectedState("preview session was not initialized".into()));
+        }
+        // CarPlay may make MainAudio duplex when Maps/Siri speech recognition
+        // becomes active. The decoded phone-to-accessory side is still accepted
+        // here; open_microphone supplies a bounded silent evaluation source so
+        // rejecting an optional mic cannot tear down both display streams.
+        let samples_per_tick = Self::pcm_samples_per_tick(pcm_format)?;
+        let tap = self.media.audio_stream(AudioMeta {
+            stream_type,
+            audio_type,
+            audio_format,
+            pcm: pcm_format,
+            latency_us: latency.as_micros().min(u32::MAX as u128) as u32,
+            duplex,
+        });
+        Ok(Box::new(PreviewPcmPlayer::new(samples_per_tick, tap)))
+    }
+
+    async fn open_microphone(
+        &mut self,
+        _stream_type: StreamType,
+        _audio_type: AudioType,
+        pcm_format: AudioStreamBasicDescription,
+    ) -> RtspResult<AudioRecorderBox<i16>> {
+        let samples_per_tick = Self::pcm_samples_per_tick(pcm_format)?;
+        Ok(Box::new(PreviewSilenceRecorder::new(samples_per_tick)))
+    }
+}
+
+impl EventReconciler for PreviewRxSession {
+    type Error = RtspError;
+}
+
+impl EventSleeper for PreviewRxSession {}
+
+impl AsyncShutdown for PreviewRxSession {
+    async fn shutdown(&mut self) {
+        self.finish_session(1);
+    }
+}
+
+impl Drop for PreviewRxSession {
+    fn drop(&mut self) {
+        self.finish_session(1);
+    }
+}
