+use std::error::Error;
+
+use catplay_carplay::carplay_rx::sink::AirPlayServerShared;
+use catplay_carplay_rx_gadget::CarPlayWirelessGadget;
+use catplay_util::{EventReconciler, EventSleeper, EventToken, Reconciler};
+
+use crate::{AppConfig, HomeKitManager, MediaTap, MfiManager, PreviewRxSession, TelemetrySnapshot};
+
+/// Owns only the wireless receiver reconciler. There is intentionally no
+/// `ProdGadget`, `CarPlayOutputManager`, TX adapter, UDC, or configfs field in
+/// this runtime.
+pub struct InputOnlyManager {
+    receiver: Reconciler<CarPlayWirelessGadget<PreviewRxSession>>,
+}
+
+impl InputOnlyManager {
+    pub fn start(config: &AppConfig, mfi: &MfiManager, homekit: &HomeKitManager, media: MediaTap) -> Result<Self, Box<dyn Error>> {
+        if !config.bluetooth.enabled || config.bluetooth.device.trim().is_empty() {
+            return Err("input-only wireless receiver requires an enabled Bluetooth HCI device".into());
+        }
+        if !config.wifi.enabled || config.wifi.device.trim().is_empty() {
+            return Err("input-only wireless receiver requires the configured AP interface".into());
+        }
+        let homekit_rx = homekit
+            .homekit_rx
+            .clone()
+            .ok_or_else(|| std::io::Error::other("HomeKit RX storage was not initialized"))?;
+        let shared = AirPlayServerShared::new();
+        let mut receiver = CarPlayWirelessGadget::new(
+            homekit_rx,
+            Some(mfi.get_device()),
+            shared,
+            &config.bluetooth.name,
+            &config.bluetooth.device,
+            &config.wifi.device,
+            &config.wifi_network.ssid,
+            Some(&config.wifi_network.password),
+            config.wifi_network.wpa,
+            config.wifi_network.channel,
+            // The preview mode is deliberately stateless with respect to
+            // Bluetooth reconnect invitations; it only accepts live discovery.
+            None,
+            move || PreviewRxSession::new(media.clone()),
+        );
+        // Explicitly retain the gadget's invite-enabled default. In normal
+        // bridge mode this is gated by a car TX session; input-only has none.
+        receiver.child_mut().set_invites_blocked(false);
+        Ok(Self { receiver })
+    }
+
+    pub async fn reconcile(&mut self) {
+        let _ = self.receiver.reconcile().await;
+    }
+
+    pub async fn sleep(&mut self) -> Option<EventToken> {
+        self.receiver.sleep().await
+    }
+
+    pub fn telemetry_snapshot(&mut self) -> TelemetrySnapshot {
+        match self.receiver.state() {
+            Ok(state) => TelemetrySnapshot::from_input_only_wireless_state(Some(state)),
+            Err(_) => TelemetrySnapshot::input_only_error(),
+        }
+    }
+}
