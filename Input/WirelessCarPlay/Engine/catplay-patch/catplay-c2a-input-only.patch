+            screen.process_frame(frame()).await.unwrap();
+        }
+        let (control, video, audio) = tap.test_queue_counts();
+        assert!(control <= 16);
+        assert!(video <= 8, "dual-screen video queue must remain fixed at eight frames");
+        assert_eq!(audio, 0);
+
+        let audio_tap = tap.audio_stream(AudioMeta {
+            stream_type: StreamType::MainAudio,
+            audio_type: AudioType::Media,
+            audio_format: AudioFormat::PCM_48000_STEREO,
+            pcm: pcm(),
+            latency_us: 0,
+            duplex: false,
+        });
+        let mut source = CountingSource(Arc::new(AtomicUsize::new(0)));
+        PreviewPcmPlayer::consume_once(&mut source, &audio_tap, MAX_PREVIEW_PCM_SAMPLES);
+        for _ in 0..16 {
+            PreviewPcmPlayer::consume_once(&mut source, &audio_tap, MAX_PREVIEW_PCM_SAMPLES);
+        }
+        assert!(source.0.load(Ordering::Relaxed) > 0);
+        assert!(tap.test_queue_counts().2 <= 32, "dual-stream audio queue must remain fixed at thirty-two chunks");
+
+        drop(audio_tap);
+        drop(screen);
+        tap.end_session(1);
+        assert_eq!(tap.test_active_session(), 0);
+        assert!(tap.test_queue_counts().0 <= 16, "teardown control remains bounded");
+    }
+
+    #[test]
+    fn delayed_preview_drop_cannot_end_a_newer_media_epoch() {
+        let tap = MediaTap::test_tap();
+        let mut old_preview = PreviewRxSession::new(tap.clone());
+        let first = old_preview.test_begin_session();
+        let mut newer_preview = PreviewRxSession::new(tap.clone());
+        let second = newer_preview.test_begin_session();
+        assert_ne!(first, second);
+        assert_eq!(tap.test_active_session(), second);
+
+        // This is the production owner path: old Drop has only its own epoch.
+        drop(old_preview);
+        assert_eq!(tap.test_active_session(), second);
+        drop(newer_preview);
+        assert_eq!(tap.test_active_session(), 0);
+    }
+
+    #[test]
+    fn negotiated_pcm_and_silent_microphone_are_fixed_capacity() {
+        assert_eq!(PreviewRxSession::pcm_samples_per_tick(pcm()).unwrap(), MAX_PREVIEW_PCM_SAMPLES);
+        let mut unsupported = pcm();
+        unsupported.channels_per_frame = 3;
+        assert!(matches!(
+            PreviewRxSession::pcm_samples_per_tick(unsupported),
+            Err(RtspError::NotSupported)
+        ));
+    }
+}
