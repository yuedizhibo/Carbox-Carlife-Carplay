+/// Reject every MFi shape except the physical Auth 3.0 coprocessor on
+/// `/dev/i2c-1` at `0x10`.
+///
+/// This pure guard must run before *any* gadget, MFi, or I2C side effect. It
+/// deliberately rejects an inactive server stanza too: accepting it would make
+/// a later configuration change an implicit bypass of the board allowlist.
+pub fn validate_zero2w_mfi_config(config: &AppConfig) -> Result<(), String> {
+    if config.mfi.client.is_some() {
+        return Err("MFi remote/client backends are forbidden; only /dev/i2c-1@0x10 is allowed".into());
+    }
+    if config.mfi.server.is_some() {
+        return Err("MFi server backends are forbidden; only /dev/i2c-1@0x10 is allowed".into());
+    }
+
+    let Some(i2c) = config.mfi.i2c.as_ref() else {
+        return Err("MFi I2C backend is required at /dev/i2c-1@0x10".into());
+    };
+    if i2c.bus_offset != ZERO2W_MFI_BUS_OFFSET {
+        return Err(format!(
+            "MFi bus {} is forbidden; only bus {} is allowed",
+            i2c.bus_offset, ZERO2W_MFI_BUS_OFFSET
+        ));
+    }
+    if i2c.dev_addr != ZERO2W_MFI_DEVICE_ADDRESS {
+        return Err(format!(
+            "MFi address 0x{:02x} is forbidden; only 0x{:02x} is allowed",
+            i2c.dev_addr, ZERO2W_MFI_DEVICE_ADDRESS
+        ));
+    }
+    Ok(())
+}
