+
+/// The PCM clock runs on one small-stack native thread per open output stream.
+/// Running it on CatPlay's busy current-thread Tokio executor with
+/// `MissedTickBehavior::Skip` permanently lost every delayed 10 ms tick. The
+/// RTP consumer then fell progressively behind the producer until its bounded
+/// ring overflowed and emitted silence. An absolute monotonic deadline here
+/// catches up rare scheduler delays instead of deleting audio time.
+struct PreviewPcmPlayer {
+    source: Option<AudioSourceBox<i16>>,
+    tap: Option<AudioTap>,
+    samples_per_tick: usize,
+    task: Option<thread::JoinHandle<()>>,
+    stop: Arc<AtomicBool>,
+}
+
+impl PreviewPcmPlayer {
+    fn new(samples_per_tick: usize, tap: AudioTap) -> Self {
+        Self {
+            source: None,
+            tap: Some(tap),
+            samples_per_tick,
+            task: None,
+            stop: Arc::new(AtomicBool::new(false)),
+        }
+    }
+
+    fn consume_once(source: &mut dyn AudioSource<Sample = i16>, tap: &AudioTap, samples_per_tick: usize) {
+        let mut samples = [0_i16; MAX_PREVIEW_PCM_SAMPLES];
+        source.read(&mut samples[..samples_per_tick]);
+        tap.samples(&samples[..samples_per_tick]);
+    }
+
+    fn stop_task(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(task) = self.task.take() {
+            let _ = task.join();
+        }
+        // Dropping an unstarted tap still emits a bounded AUDIO_END event.
+        self.tap.take();
+    }
+}
+
+impl AudioPlayer for PreviewPcmPlayer {
+    type Sample = i16;
+
+    fn init(&mut self, source: AudioSourceBox<Self::Sample>) -> RtspResult<()> {
+        self.source.replace(source);
+        Ok(())
+    }
+
+    fn start(&mut self) {
+        if self.task.is_some() {
+            return;
+        }
+        let (Some(mut source), Some(tap)) = (self.source.take(), self.tap.take()) else {
+            return;
+        };
+        let samples_per_tick = self.samples_per_tick;
+        let stop = self.stop.clone();
+        stop.store(false, Ordering::Release);
+        match thread::Builder::new()
+            .name("catplay-pcm".into())
+            .stack_size(128 * 1024)
+            .spawn(move || {
+                let mut deadline = Instant::now();
+                while !stop.load(Ordering::Acquire) {
+                    Self::consume_once(source.as_mut(), &tap, samples_per_tick);
+                    deadline += PREVIEW_PCM_CADENCE;
+                    let now = Instant::now();
+                    if deadline > now {
+                        thread::sleep(deadline - now);
+                    }
+                }
+            }) {
+            Ok(task) => self.task = Some(task),
+            Err(error) => warn!("Failed to start PCM clock: {error}"),
+        }
+    }
+
+    fn stop(&mut self, _drain: bool) {
+        self.stop_task();
+    }
+}
+
+impl Drop for PreviewPcmPlayer {
+    fn drop(&mut self) {
+        self.stop_task();
+    }
+}
+
+/// Evaluation-only microphone source. It writes bounded silence so an iPhone
+/// speech-recognition MainAudio SETUP can remain valid without claiming that a
+/// physical microphone is present. Replace this with the real capture source
+/// before reporting microphone support as active.
+struct PreviewSilenceRecorder {
+    sink: Option<AudioSinkBox<i16>>,
+    samples_per_tick: usize,
+    task: Option<thread::JoinHandle<()>>,
+    stop: Arc<AtomicBool>,
+}
+
+impl PreviewSilenceRecorder {
+    fn new(samples_per_tick: usize) -> Self {
+        Self {
+            sink: None,
+            samples_per_tick,
+            task: None,
+            stop: Arc::new(AtomicBool::new(false)),
+        }
+    }
+
+    fn stop_task(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(task) = self.task.take() {
+            let _ = task.join();
+        }
+        self.sink.take();
+    }
+}
+
+impl AudioRecorder for PreviewSilenceRecorder {
+    type Sample = i16;
+
+    fn init(&mut self, sink: AudioSinkBox<Self::Sample>) -> RtspResult<()> {
+        self.sink.replace(sink);
+        Ok(())
+    }
+
+    fn start(&mut self) {
+        if self.task.is_some() {
+            return;
+        }
+        let Some(mut sink) = self.sink.take() else {
+            return;
+        };
+        let samples_per_tick = self.samples_per_tick;
+        let stop = self.stop.clone();
+        stop.store(false, Ordering::Release);
+        match thread::Builder::new()
+            .name("catplay-mic-silence".into())
+            .stack_size(128 * 1024)
+            .spawn(move || {
+                let silence = [0_i16; MAX_PREVIEW_PCM_SAMPLES];
+                let mut deadline = Instant::now();
+                while !stop.load(Ordering::Acquire) {
+                    let writable = sink.writable().min(samples_per_tick);
+                    if writable != 0 {
+                        sink.write(&silence[..writable]);
+                    }
+                    deadline += PREVIEW_PCM_CADENCE;
+                    let now = Instant::now();
+                    if deadline > now {
+                        thread::sleep(deadline - now);
+                    }
+                }
+            }) {
+            Ok(task) => self.task = Some(task),
+            Err(error) => warn!("Failed to start silence microphone clock: {error}"),
+        }
+    }
+
+    fn stop(&mut self, _drain: bool) {
+        self.stop_task();
+    }
+}
+
+impl Drop for PreviewSilenceRecorder {
+    fn drop(&mut self) {
+        self.stop_task();
+    }
+}
