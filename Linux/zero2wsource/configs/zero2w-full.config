# Orange Pi Zero 2W —— 板载全部外设 + GPIO 内核配置片段
# 用法：先 make linux_sunxi64_defconfig，再 cat 本文件 >> .config && make olddefconfig
# 标注：[板载] = Zero2W 上真实存在的硬件；[扩展] = 为车机/镜像投屏场景预留

# ---------- 版本标识 ----------
CONFIG_LOCALVERSION="-zero2w"
# CONFIG_LOCALVERSION_AUTO is not set

# ---------- [板载] SoC H618 基础 ----------
CONFIG_ARCH_SUNXI=y
CONFIG_SUNXI_SRAM=y
CONFIG_SUNXI_MBUS=y
CONFIG_SUN50I_IOMMU=y
CONFIG_SUNXI_RSB=y                      # AXP313/AC200 用的 RSB 总线
CONFIG_RESET_SUNXI=y
CONFIG_SUNXI_CCU=y
CONFIG_SUN50I_H616_CCU=y
CONFIG_SUN50I_H6_R_CCU=y
CONFIG_SUN6I_R_INTC=y
CONFIG_SUNXI_NMI_INTC=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_SUNXI_SYS_INFO=y
CONFIG_SUNXI_ADDR_MGT=y
CONFIG_SUN6I_MSGBOX=y
CONFIG_HWSPINLOCK_SUN6I=y
CONFIG_DMA_SUN6I=y
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_NVMEM_SUNXI_SID=y
CONFIG_NVMEM_SYSFS=y
CONFIG_SUN8I_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_HWMON=y
CONFIG_PINCTRL_SUNXI=y
CONFIG_PINCTRL_SUN50I_H616=y
CONFIG_PINCTRL_SUN50I_H616_R=y

# ---------- [板载] GPIO：40Pin / 24Pin 全部可用 ----------
CONFIG_GPIOLIB=y
CONFIG_GPIOLIB_IRQCHIP=y
CONFIG_OF_GPIO=y
CONFIG_GPIO_SYSFS=y                    # /sys/class/gpio/export （wiringOP 老接口）
CONFIG_GPIO_CDEV=y                     # /dev/gpiochipN （libgpiod / gpioinfo）
CONFIG_GPIO_CDEV_V1=y
CONFIG_GPIO_GENERIC=y

# ---------- [板载] LED / 状态灯 ----------
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y                     # PC13 状态灯, PC15/PC16 网口灯
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_GPIO=y
CONFIG_LEDS_TRIGGER_NETDEV=y

# ---------- [板载] 按键 / 红外 / 输入 ----------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y                 # 40Pin 上接 gpio-keys 按键
CONFIG_KEYBOARD_GPIO_POLLED=m
CONFIG_KEYBOARD_SUN4I_LRADC=y          # 板载 LRADC 分压按键（含 power key）
CONFIG_MEDIA_SUPPORT=y
CONFIG_RC_CORE=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SUNXI=y                      # 板载 IR 接收头
CONFIG_INPUT_UINPUT=m

# ---------- [板载] 串口（UART0 调试 + 40Pin UART2~5） ----------
CONFIG_TTY=y
CONFIG_HW_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=8
CONFIG_SERIAL_8250_RUNTIME_UARTS=8
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_MANY_PORTS=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_DEV_BUS=y                # 蓝牙 HCI 用 serdev
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# ---------- [板载] I2C / SPI + 用户态接口 ----------
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y                   # /dev/i2c-N （i2c-tools）
CONFIG_I2C_HELPER_AUTO=y
CONFIG_I2C_MV64XXX=y                   # H616 的 TWI 控制器
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_SUN4I=y                     # SPI0 -> 板载 16MB NOR
CONFIG_SPI_SUN6I=y
CONFIG_SPI_SPIDEV=y                    # /dev/spidevN.M （40Pin 外接 SPI 设备）

# ---------- [板载] TF 卡 / SDIO / SPI NOR / 块设备 ----------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=16
CONFIG_MMC_SUNXI=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_PARTITIONS=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_OF_PARTS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# ---------- 文件系统 ----------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_CONFIGFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y

# ---------- [板载] Wi-Fi：AP6256 / BCM43455（SDIO@mmc1） ----------
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PROC=y
CONFIG_WEXT_SPY=y
CONFIG_WEXT_PRIV=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BRCMFMAC_SDIO=y
# [扩展] 常见 USB Wi-Fi 适配器
CONFIG_RTLWIFI=m
CONFIG_RTL8XXXU=m
CONFIG_MT7601U=m
CONFIG_USB_NET_RNDIS_WLAN=m

# ---------- [板载] 蓝牙：BCM43455 over UART ----------
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HS=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIVHCI=m
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCSP=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=y

# ---------- 网络（CarPlay 需要 AP/桥接/NAT） ----------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NET_KEY=m
CONFIG_XFRM_USER=m
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_VLAN_8021Q=y
CONFIG_DUMMY=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NF_CT_NETLINK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_PPP=m

# ---------- [板载] 100M 以太网：H616 EMAC + AC200 ePHY(RMII) ----------
CONFIG_MFD_AC200=y                     # X-Powers AC200（内含 100M PHY，bool 不能=）
CONFIG_PHYLIB=y
CONFIG_MDIO_SUN4I=y
CONFIG_MDIO_SUNXI=y                      # 由 SUNXI_GMAC select 自动打开                      # 由 SUNXI_GMAC select，自动打开
CONFIG_NET_VENDOR_ALLWINNER=y
CONFIG_SUN4I_EMAC=y
CONFIG_SUNXI_GMAC=y                      # ★Zero2W 网口真正的驱动：compatible="allwinner,sunxi-gmac"
CONFIG_DWMAC=y
CONFIG_DWMAC_SUN8I=y                   # 匹配 "allwinner,sun50i-a64-emac"

# ---------- [板载] 显示：mini-HDMI + DE2 ----------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y
CONFIG_FONT_SUPPORT=y
CONFIG_SUN50I_DE2_BUS=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN4I_BACKEND=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_DW_HDMI=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_DRM_DW_HDMI_CEC=y
CONFIG_DRM_SUN4I_HDMI_CEC=y
CONFIG_CEC_CORE=y
CONFIG_CEC_PLATFORM_DRIVERS=y
CONFIG_HDMI=y

# ---------- [板载] GPU：Mali-G31 MP2 ----------
CONFIG_DRM_PANFROST=y

# ---------- [板载] VPU / 2D ----------
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_V4L2_H264=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_CONTROLLER_REQUEST_API=y
CONFIG_MEDIA_CONTROLLER_REQUEST_API=y
CONFIG_VIDEO_V4L2=m
CONFIG_VIDEO_SUNXI=y
CONFIG_VIDEO_SUNXI_CEDRUS=y
CONFIG_VIDEO_HANTRO=y
CONFIG_VIDEO_HANTRO_SUNXI=y

# ---------- [板载] 音频：H616 内置 codec + HDMI 音频 ----------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN50IW9_CODEC=y
CONFIG_SND_SOC_SUNXI_SUN50IW9_CODEC=y
CONFIG_SND_SUN50I_CODEC_ANALOG=y
CONFIG_SND_SUN50I_DMIC=y
CONFIG_SND_SOC_DMIC=y
CONFIG_SND_SOC_SUNXI_AHUB=y
CONFIG_SND_SOC_SUNXI_AHUB_DAM=y
CONFIG_SND_SOC_SUNXI_MACH=y
CONFIG_SND_SOC_SUNXI_INTERNALCODEC=y
CONFIG_SND_SOC_SUNXI_AAUDIO=y
CONFIG_SND_SOC_HDMI_CODEC=y
CONFIG_SND_SOC_SPDIF=y
CONFIG_SND_SOC_BT_SCO=y
CONFIG_SND_SOC_AW8738=y                # AWINIC 功放（板载/扩展）
CONFIG_SND_SOC_ES8328=m                # [扩展] 常见 I2C codec
CONFIG_SND_SOC_ES8316=m
CONFIG_SND_USB_AUDIO=y                 # [扩展] USB 声卡（CarPlay 音频输出）

# ---------- [板载/扩展] USB ----------
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_PLATFORM=m
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_EHCI_ROOT_HUB_TT=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_ACM=m
CONFIG_USB_PRINTER=m
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
# USB-C 作 device：FunctionFS / gadget（CarPlay 有线、ADB、U 盘仿真）
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_FS=y
CONFIG_USB_FUNCTIONFS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_LB_SS=y
CONFIG_USB_CONFIGFS_F_UAC1_LEGACY=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_PRINTER=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_PHY_SUN4I_USB=y
# [扩展] USB 摄像头（镜像投屏/环视）
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y

# ---------- [板载能力] CAN（车机场景，H616 有 CAN 控制器） ----------
CONFIG_CAN=y
CONFIG_CAN_DEV=y
# CONFIG_CAN_SUN4I is not set            # 本 BSP 的 sun4i_can 只支持 A10/A20(MACH_SUN4I)，H616 CAN 需全志 SDK 的 sunxi-can
CONFIG_CAN_RAW=m

# ---------- 加密 ----------
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_DEV_SUN4I_SS=m           # 全志硬件加密引擎
CONFIG_KEYS=y
CONFIG_SECURITYFS=y

# ---------- RTC ----------
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SUN6I=y                 # H616 的 rtc 由 rtc-sun6i.c 匹配 "allwinner,sun50i-h616-rtc"
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_INTF_PROC=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"

# ---------- IIO（GPADC：LRADC/温度） ----------
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_SUN4I_GPADC=y

# ---------- systemd / 容器 / 调试需要 ----------
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_OF_OVERLAY=y                    # ★ DT overlay（改外设不用重烧整块 dtb）
CONFIG_PROC_DEVICETREE=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_POWER_RESET=y
CONFIG_HW_RANDOM=y

# ---------- 保持轻量：不开调试信息（编译快 3-5 倍） ----------
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_CMDLINE_FORCE is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
